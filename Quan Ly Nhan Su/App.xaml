<Application x:Class="TaxPersonnelManagement.App"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"

             xmlns:local="clr-namespace:TaxPersonnelManagement"

             xmlns:helpers="clr-namespace:TaxPersonnelManagement.Helpers"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"

             Startup="Application_Startup">

    <Application.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <!-- Base Material Theme -->

                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Lime" />

                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />

                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Shadows.xaml" />

                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Button.xaml" />

                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ComboBox.xaml" />

            </ResourceDictionary.MergedDictionaries>



            <BooleanToVisibilityConverter x:Key="BoolToVis"/>



            <!-- ============================== -->

            <!--       PREMIUM UI RESOURCES     -->

            <!-- ============================== -->



            <!-- 1. Color Palette (Windows 11 Blue & Professional Accents) -->

            <SolidColorBrush x:Key="PrimaryColor">#0078D4</SolidColorBrush> <!-- Windows Blue -->

            <SolidColorBrush x:Key="PrimaryDarkColor">#005A9E</SolidColorBrush>

            <SolidColorBrush x:Key="SecondaryColor">#FF8C00</SolidColorBrush> <!-- Dark Orange -->

            <SolidColorBrush x:Key="BackgroundColor">#F3F3F3</SolidColorBrush>

            <SolidColorBrush x:Key="CardBackground">#FFFFFF</SolidColorBrush>

            <SolidColorBrush x:Key="TextPrimary">#323130</SolidColorBrush>

            <SolidColorBrush x:Key="TextSecondary">#605E5C</SolidColorBrush>



            <!-- 2. Typography (Bộ font Segoe UI hiện đại, thanh lịch, chuẩn mực Fluent & Windows 11) -->

            <FontFamily x:Key="AppRegularFont">Segoe UI, Helvetica Neue, Arial, sans-serif</FontFamily>

            <FontFamily x:Key="AppHeadingFont">Segoe UI, Helvetica Neue, Arial, sans-serif</FontFamily>

            <FontFamily x:Key="MaterialDesignFont">Segoe UI, Helvetica Neue, Arial, sans-serif</FontFamily>



            <!-- Reusable Uppercase Heading Style -->

            <Style x:Key="UppercaseHeadingStyle" TargetType="TextBlock">

                <Setter Property="FontFamily" Value="{StaticResource AppHeadingFont}"/>

                <Setter Property="FontWeight" Value="Bold"/>

                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>

                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>

            </Style>



            <!-- Global Styles -->

            <Style TargetType="TextBlock" x:Key="CenterAlignedCell">

                <Setter Property="VerticalAlignment" Value="Center"/>

                <Setter Property="Padding" Value="5 0"/>

            </Style>



            <!-- Fix for DataGrid StaticResource Exception: Global Styles -->

            <Style TargetType="DataGridCell" x:Key="LeaveHistoryCellStyle">

                <Setter Property="ClipToBounds" Value="False"/>

                <Setter Property="Panel.ZIndex" Value="100"/>

                <Setter Property="BorderThickness" Value="0"/>

                <Setter Property="BorderBrush" Value="Transparent"/>

                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            </Style>



            <!-- Global DataGrid Focus & Selection Border Removal (Khắc phục viền đen khi click cell) -->

            <SolidColorBrush x:Key="{x:Static DataGrid.FocusBorderBrushKey}" Color="Transparent"/>



            <!-- Global Sharp Font & ClearType Settings to prevent blurry fonts -->

            <Style TargetType="{x:Type TextElement}">

                <Setter Property="FontFamily" Value="{StaticResource AppRegularFont}"/>

                <Setter Property="FontSize" Value="14.5"/>

                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>

                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>

            </Style>



            <Style TargetType="{x:Type Window}">

                <Setter Property="FontFamily" Value="{StaticResource AppRegularFont}"/>

                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>

                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>

                <Setter Property="UseLayoutRounding" Value="True"/>

                <Setter Property="SnapsToDevicePixels" Value="True"/>

            </Style>



            <Style TargetType="{x:Type Page}">

                <Setter Property="FontFamily" Value="{StaticResource AppRegularFont}"/>

                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>

                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>

                <Setter Property="UseLayoutRounding" Value="True"/>

                <Setter Property="SnapsToDevicePixels" Value="True"/>

            </Style>



            <Style TargetType="{x:Type UserControl}">

                <Setter Property="FontFamily" Value="{StaticResource AppRegularFont}"/>

                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>

                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>

                <Setter Property="UseLayoutRounding" Value="True"/>

                <Setter Property="SnapsToDevicePixels" Value="True"/>

            </Style>



            <!-- ========================================== -->
            <!-- MODERN FLUENT CALENDAR STYLES (WINDOWS 11) -->
            <!-- ========================================== -->

            <!-- 1. Day Button in Month View (32x32 rounded pills with soft hover & Windows Blue selection) -->
            <Style x:Key="ModernCalendarDayButton" TargetType="{x:Type primitives:CalendarDayButton}">
                <Setter Property="MinWidth" Value="32"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontFamily" Value="{StaticResource AppRegularFont}"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#1E293B"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type primitives:CalendarDayButton}">
                            <Grid Margin="1" SnapsToDevicePixels="True">
                                <Border x:Name="DayBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        SnapsToDevicePixels="True"/>
                                
                                <Border x:Name="TodayIndicator"
                                        BorderBrush="#0078D4"
                                        BorderThickness="1.5"
                                        CornerRadius="8"
                                        Visibility="Collapsed"
                                        SnapsToDevicePixels="True"/>

                                <ContentPresenter x:Name="NormalText"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>

                                <Path x:Name="Blackout"
                                      Data="M0,0 L1,1 M0,1 L1,0"
                                      Stretch="Fill"
                                      Stroke="#94A3B8"
                                      StrokeThickness="1"
                                      Margin="6"
                                      Visibility="Collapsed"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsInactive" Value="True">
                                    <Setter TargetName="NormalText" Property="TextElement.Foreground" Value="#94A3B8"/>
                                </Trigger>
                                
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="DayBorder" Property="Background" Value="#F1F5F9"/>
                                    <Setter TargetName="NormalText" Property="TextElement.Foreground" Value="#0F172A"/>
                                </Trigger>

                                <Trigger Property="IsToday" Value="True">
                                    <Setter TargetName="TodayIndicator" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="NormalText" Property="TextElement.Foreground" Value="#0078D4"/>
                                    <Setter TargetName="NormalText" Property="TextElement.FontWeight" Value="SemiBold"/>
                                </Trigger>

                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="DayBorder" Property="Background" Value="#0078D4"/>
                                    <Setter TargetName="DayBorder" Property="BorderBrush" Value="#0078D4"/>
                                    <Setter TargetName="NormalText" Property="TextElement.Foreground" Value="White"/>
                                    <Setter TargetName="NormalText" Property="TextElement.FontWeight" Value="Bold"/>
                                    <Setter TargetName="TodayIndicator" Property="Visibility" Value="Collapsed"/>
                                </Trigger>

                                <Trigger Property="IsBlackedOut" Value="True">
                                    <Setter TargetName="Blackout" Property="Visibility" Value="Visible"/>
                                    <Setter Property="Opacity" Value="0.4"/>
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 2. Month / Year Button in Year View -->
            <Style x:Key="ModernCalendarButton" TargetType="{x:Type primitives:CalendarButton}">
                <Setter Property="MinWidth" Value="54"/>
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontFamily" Value="{StaticResource AppRegularFont}"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#1E293B"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type primitives:CalendarButton}">
                            <Grid Margin="2" SnapsToDevicePixels="True">
                                <Border x:Name="ButtonBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        SnapsToDevicePixels="True"/>
                                <ContentPresenter x:Name="NormalText"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsInactive" Value="True">
                                    <Setter TargetName="NormalText" Property="TextElement.Foreground" Value="#94A3B8"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#F1F5F9"/>
                                    <Setter TargetName="NormalText" Property="TextElement.Foreground" Value="#0F172A"/>
                                </Trigger>
                                <Trigger Property="HasSelectedDays" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#0078D4"/>
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#0078D4"/>
                                    <Setter TargetName="NormalText" Property="TextElement.Foreground" Value="White"/>
                                    <Setter TargetName="NormalText" Property="TextElement.FontWeight" Value="Bold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 3. Navigation Chevron Buttons -->
            <ControlTemplate x:Key="ModernCalendarNavButtonTemplate" TargetType="Button">
                <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Width="30" Height="30" Cursor="Hand" SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.25"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!-- 4. Month/Year Header Button -->
            <ControlTemplate x:Key="ModernCalendarHeaderButtonTemplate" TargetType="Button">
                <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,5" Cursor="Hand" SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.FontFamily="{StaticResource AppHeadingFont}"
                                      TextElement.FontSize="13.5"
                                      TextElement.FontWeight="Bold"
                                      TextElement.Foreground="#0F172A"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                        <Setter Property="TextElement.Foreground" Value="#0078D4"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!-- 5. Calendar Item Layout -->
            <Style x:Key="ModernCalendarItemStyle" TargetType="{x:Type primitives:CalendarItem}">
                <Style.Resources>
                    <DataTemplate x:Key="{x:Static primitives:CalendarItem.DayTitleTemplateResourceKey}">
                        <TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0 4 0 6"/>
                    </DataTemplate>
                </Style.Resources>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type primitives:CalendarItem}">
                            <Grid x:Name="PART_Root" Background="{TemplateBinding Background}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header: Tháng trước, Tiêu đề Tháng/Năm, Tháng sau -->
                                <Grid Grid.Row="0" Margin="0 0 0 8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="PART_PreviousButton" Grid.Column="0" Focusable="False"
                                            Template="{StaticResource ModernCalendarNavButtonTemplate}"
                                            ToolTip="Tháng trước">
                                        <materialDesign:PackIcon Kind="ChevronLeft" Width="20" Height="20" Foreground="#475569"/>
                                    </Button>

                                    <Button x:Name="PART_HeaderButton" Grid.Column="1" HorizontalAlignment="Center" Focusable="False"
                                            Template="{StaticResource ModernCalendarHeaderButtonTemplate}"/>

                                    <Button x:Name="PART_NextButton" Grid.Column="2" Focusable="False"
                                            Template="{StaticResource ModernCalendarNavButtonTemplate}"
                                            ToolTip="Tháng sau">
                                        <materialDesign:PackIcon Kind="ChevronRight" Width="20" Height="20" Foreground="#475569"/>
                                    </Button>
                                </Grid>

                                <!-- Month View: 7x7 Grid -->
                                <Grid x:Name="PART_MonthView" Grid.Row="1" Visibility="Visible">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                </Grid>

                                <!-- Year View: 3x4 Grid -->
                                <Grid x:Name="PART_YearView" Grid.Row="1" Visibility="Hidden">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 6. Modern Calendar Main Style -->
            <Style x:Key="ModernCalendarStyle" TargetType="{x:Type Calendar}">
                <Setter Property="CalendarDayButtonStyle" Value="{StaticResource ModernCalendarDayButton}"/>
                <Setter Property="CalendarButtonStyle" Value="{StaticResource ModernCalendarButton}"/>
                <Setter Property="CalendarItemStyle" Value="{StaticResource ModernCalendarItemStyle}"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Language" Value="vi-VN"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Calendar}">
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="10 8" Margin="4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.12"/>
                                </Border.Effect>
                                <CalendarItem x:Name="PART_CalendarItem"
                                              Style="{TemplateBinding CalendarItemStyle}"
                                              Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="0"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Global Default Calendar Override (Toàn bộ ứng dụng sử dụng giao diện lịch mới) -->
            <Style TargetType="{x:Type Calendar}" BasedOn="{StaticResource ModernCalendarStyle}" />

            <!-- Global Default DatePicker Style: Mọi DatePicker trong ứng dụng đều dùng ModernCalendarStyle -->
            <Style TargetType="{x:Type DatePicker}">
                <Setter Property="Language" Value="vi-VN"/>
                <Setter Property="helpers:DatePickerHelper.FixCalendarLocale" Value="True"/>
                <Setter Property="helpers:DatePickerHelper.EnableSmartDateEntry" Value="True"/>
                <Setter Property="CalendarStyle" Value="{StaticResource ModernCalendarStyle}"/>
            </Style>

            <!-- Modern DatePicker Style dùng chung -->
            <Style x:Key="ModernDatePicker" TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
                <Setter Property="Height" Value="35"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#D0D0D0"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Padding" Value="10 0"/>
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="CalendarStyle" Value="{StaticResource ModernCalendarStyle}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DatePicker">
                            <Border x:Name="border" Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <DatePickerTextBox x:Name="PART_TextBox" 
                                                       Grid.Column="0"
                                                       HorizontalContentAlignment="Stretch"
                                                       VerticalContentAlignment="Center"
                                                       Background="Transparent" 
                                                       BorderThickness="0"
                                                       Padding="{TemplateBinding Padding}"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       FontWeight="{TemplateBinding FontWeight}"
                                                       FontSize="{TemplateBinding FontSize}"
                                                       Focusable="True">
                                        <DatePickerTextBox.Template>
                                            <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                                                <Grid>
                                                    <ScrollViewer x:Name="PART_ContentHost" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                    <TextBlock x:Name="Watermark" Text="dd/MM/yyyy" 
                                                               IsHitTestVisible="False" 
                                                               Foreground="Gray" Opacity="0.7"
                                                               VerticalAlignment="Center" 
                                                               Margin="{TemplateBinding Padding}"
                                                               Visibility="Hidden"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </DatePickerTextBox.Template>
                                    </DatePickerTextBox>

                                    <Button x:Name="PART_Button" 
                                            Grid.Column="1" 
                                            Width="30"
                                            Padding="0"
                                            Margin="0 0 5 0"
                                            Background="Transparent" 
                                            BorderThickness="0"
                                            Foreground="#64748B"
                                            Cursor="Hand"
                                            Focusable="False"
                                            Style="{DynamicResource MaterialDesignToolButton}"
                                            ToolTip="Chọn ngày từ lịch">
                                        <materialDesign:PackIcon Kind="CalendarMonthOutline" Width="18" Height="18"/>
                                    </Button>

                                    <Popup x:Name="PART_Popup" 
                                           AllowsTransparency="True" 
                                           Placement="Bottom" 
                                           VerticalOffset="4"
                                           PopupAnimation="Fade"
                                           StaysOpen="False"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>



            <!-- 3. Overriding Material Brushes to enforce our Palette -->

            <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#0078D4"/>

            <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="#C7E0F4"/>

            <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="#005A9E"/>

            <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="White"/>



            <!-- 4. BUTTON STYLES (Chuẩn phong cách Windows 11 Fluent: thanh lịch, bóng đổ nhẹ, tương tác mượt mà) -->

            

<!-- Primary Action Button (Filled, Bold, Soft Subtle Shadow) -->

            <Style x:Key="PremiumButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">

                <Setter Property="Background" Value="{StaticResource PrimaryColor}" />

                <Setter Property="BorderThickness" Value="0" />

                <Setter Property="Foreground" Value="White" />

                <Setter Property="Height" Value="40" />

                <Setter Property="FontSize" Value="14" />

                <Setter Property="FontWeight" Value="SemiBold" />

                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6" />

                <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1" />

                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

                <Setter Property="Cursor" Value="Hand" />

                <Style.Triggers>

                    <Trigger Property="IsMouseOver" Value="True">

                        <Setter Property="Background" Value="#106EBE" />

                        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2" />

                    </Trigger>

                    <Trigger Property="IsPressed" Value="True">

                        <Setter Property="Background" Value="{StaticResource PrimaryDarkColor}" />

                        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp0" />

                    </Trigger>

                </Style.Triggers>

            </Style>



            <!-- Secondary/Outline Button (Phẳng, không bóng đổ, hiệu ứng hover nhẹ nhàng) -->

            <Style x:Key="PremiumOutlineButtonStyle" TargetType="Button">

                <Setter Property="BorderBrush" Value="#CBD5E1" />

                <Setter Property="Foreground" Value="#475569" />

                <Setter Property="Background" Value="Transparent" />

                <Setter Property="BorderThickness" Value="1" />

                <Setter Property="Height" Value="40" />

                <Setter Property="FontSize" Value="14" />

                <Setter Property="FontWeight" Value="SemiBold" />

                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6" />

                <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp0" />

                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

                <Setter Property="Cursor" Value="Hand" />

                <Setter Property="Template">

                    <Setter.Value>

                        <ControlTemplate TargetType="Button">

                            <Border x:Name="border"

                                    Background="{TemplateBinding Background}"

                                    BorderBrush="{TemplateBinding BorderBrush}"

                                    BorderThickness="{TemplateBinding BorderThickness}"

                                    CornerRadius="{Binding Path=(materialDesign:ButtonAssist.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"

                                    Padding="{TemplateBinding Padding}"

                                    SnapsToDevicePixels="True">

                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver" Value="True">

                                    <Setter TargetName="border" Property="Background" Value="#F1F5F9" />

                                    <Setter Property="Foreground" Value="#0F172A" />

                                    <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8" />

                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">

                                    <Setter TargetName="border" Property="Background" Value="#E2E8F0" />

                                    <Setter Property="Foreground" Value="#0F172A" />

                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">

                                    <Setter TargetName="border" Property="Opacity" Value="0.5" />

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Setter.Value>

                </Setter>

            </Style>



            <!-- Default Button Override -->

            <Style TargetType="Button" BasedOn="{StaticResource PremiumButtonStyle}" />



            <!-- 5. DATAGRID STYLE (Clean, Professional) -->

            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">

                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

                <Setter Property="Background" Value="White" />

                <Setter Property="BorderThickness" Value="0" />

                <Setter Property="GridLinesVisibility" Value="Horizontal" />

                <Setter Property="HorizontalGridLinesBrush" Value="#E0E0E0" />

                <Setter Property="VerticalGridLinesBrush" Value="Transparent" />

                <Setter Property="MinRowHeight" Value="45" />

                <Setter Property="ColumnHeaderHeight" Value="50" />

                <Setter Property="HeadersVisibility" Value="Column" />

                <Setter Property="AlternationCount" Value="0" /> <!-- No zebra striping for cleaner look -->

                <Setter Property="materialDesign:DataGridAssist.CellPadding" Value="10" />

                <Setter Property="materialDesign:DataGridAssist.ColumnHeaderPadding" Value="10" />

                <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp0" />

                <Setter Property="helpers:ClipHelper.CornerRadius" Value="12" />

                <Setter Property="FontSize" Value="14" />

            </Style>



            <Style TargetType="{x:Type DataGridColumnHeadersPresenter}">

                <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>

            </Style>



            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">

                <Setter Property="FontFamily" Value="{StaticResource AppHeadingFont}"/>

                <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}" />

                <Setter Property="FontWeight" Value="SemiBold" />

                <Setter Property="FontSize" Value="13" />

                <Setter Property="MinHeight" Value="50" />

                <Setter Property="Foreground" Value="White" />

                <Setter Property="BorderThickness" Value="0 0 1 0" />

                <Setter Property="BorderBrush" Value="#1565C0" />

                <Setter Property="Padding" Value="10 8"/>

                <Setter Property="HorizontalContentAlignment" Value="Center"/>

                <Setter Property="VerticalContentAlignment" Value="Center"/>

                <Setter Property="ContentTemplate">

                    <Setter.Value>

                        <DataTemplate>

                            <TextBlock Text="{Binding}" FontFamily="{StaticResource AppHeadingFont}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="18" Foreground="White" FontWeight="SemiBold"/>

                        </DataTemplate>

                    </Setter.Value>

                </Setter>

            </Style>

            

            <!-- Global System Highlight Colors for Soft Blue Selection (#E3F2FD) -->

            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E3F2FD"/>

            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A"/>

            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E3F2FD"/>

            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A"/>



            <!-- GLOBAL DATAGRID ROW STYLE: Hiệu ứng chọn dòng đồng bộ toàn hệ thống (#E3F2FD) -->

            <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}">

                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

                <Setter Property="Background" Value="White"/>

                <Setter Property="BorderThickness" Value="0 0 0 1"/>

                <Setter Property="BorderBrush" Value="#F1F5F9"/>

                <Setter Property="Cursor" Value="Hand"/>

                <Setter Property="VerticalContentAlignment" Value="Center"/>

                <Style.Triggers>

                    <Trigger Property="IsMouseOver" Value="True">

                        <Setter Property="Background" Value="#F5F9FF"/>

                    </Trigger>

                    <Trigger Property="IsSelected" Value="True">

                        <Setter Property="Background" Value="#E3F2FD"/>

                        <Setter Property="Foreground" Value="#0F172A"/>

                    </Trigger>

                </Style.Triggers>

            </Style>



            <!-- GLOBAL DATAGRID CELL STYLE: Trong suốt khi chọn để hiển thị nền hàng #E3F2FD mượt mà, giữ nguyên màu chữ -->

            <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource {x:Type DataGridCell}}">

                <Setter Property="Padding" Value="4 0"/>

                <Setter Property="BorderThickness" Value="0"/>

                <Setter Property="Background" Value="Transparent"/>

                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

                <Setter Property="Template">

                    <Setter.Value>

                        <ControlTemplate TargetType="{x:Type DataGridCell}">

                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">

                                <ContentPresenter VerticalAlignment="Center"/>

                            </Border>

                        </ControlTemplate>

                    </Setter.Value>

                </Setter>

                <Style.Triggers>

                    <Trigger Property="IsSelected" Value="True">

                        <Setter Property="Background" Value="Transparent"/>

                        <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"/>

                    </Trigger>

                </Style.Triggers>

            </Style>



            <!-- 6. CARD STYLE -->

            <Style TargetType="materialDesign:Card">

                <Setter Property="UniformCornerRadius" Value="8" />

                <Setter Property="Background" Value="White" />

                <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2" />

            </Style>

            

            <!-- 6b. TABLE CARD STYLE: Khung bảng danh sách đồng bộ toàn hệ thống (bo góc 12, viền mảnh). Nội dung bên trong dùng helpers:ClipHelper.CornerRadius="12" để header DataGrid được bo đều cả 2 góc. -->

            <Style x:Key="TableCardStyle" TargetType="materialDesign:Card" BasedOn="{StaticResource {x:Type materialDesign:Card}}">

                <Setter Property="UniformCornerRadius" Value="12" />

                <Setter Property="Background" Value="White" />

                <Setter Property="BorderBrush" Value="#E2E8F0" />

                <Setter Property="BorderThickness" Value="1" />

                <Setter Property="ClipToBounds" Value="True" />

                <Setter Property="helpers:ClipHelper.CornerRadius" Value="12" />

                <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1" />

            </Style>

            

            <!-- 7. MODERN INPUT STYLES (Copied from PersonnelDetailView for consistency) -->

            <!-- Modern Label -->

            <Style x:Key="ModernLabel" TargetType="TextBlock">

                <Setter Property="Foreground" Value="#666"/>

                <Setter Property="FontSize" Value="13"/>

                <Setter Property="Margin" Value="0 0 0 5"/>

                <Setter Property="FontWeight" Value="SemiBold"/>

            </Style>



            <!-- Modern TextBox -->

            <Style x:Key="ModernTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">

                <Setter Property="Height" Value="40"/>

                <Setter Property="VerticalContentAlignment" Value="Center"/>

                <Setter Property="Padding" Value="10 0"/>

                <Setter Property="BorderThickness" Value="1"/>

                <Setter Property="BorderBrush" Value="#D0D0D0"/>

                <Setter Property="Background" Value="White"/>

                <Setter Property="FontSize" Value="14"/>

                <Setter Property="Template">

                    <Setter.Value>

                            <ControlTemplate TargetType="TextBox">

                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 

                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">

                                <Grid>

                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>

                                    <TextBlock x:Name="Watermark" Text="{Binding Path=(materialDesign:HintAssist.Hint), RelativeSource={RelativeSource TemplatedParent}}"

                                               Foreground="#AAAAAA" Margin="10 0 0 0" IsHitTestVisible="False"

                                               VerticalAlignment="Center" Visibility="Collapsed"/>

                                </Grid>

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="Text" Value="">

                                    <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>

                                </Trigger>

                                <Trigger Property="IsMouseOver" Value="True">

                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>

                                </Trigger>

                                <Trigger Property="IsKeyboardFocused" Value="True">

                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>

                                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Setter.Value>

                </Setter>

            </Style>



            <!-- Modern ComboBox -->
            <Style x:Key="ModernComboBox" TargetType="ComboBox">
                <Setter Property="Height" Value="40"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="10,0,28,0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#D0D0D0"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                    <Grid>
                                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                          Margin="{TemplateBinding Padding}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>

                                        <ToggleButton x:Name="toggleButton" Focusable="False"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"
                                                      Cursor="Hand"
                                                      Style="{x:Null}"
                                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                      ClickMode="Press" Background="Transparent" BorderThickness="0">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                        <materialDesign:PackIcon Kind="ChevronDown" Width="18" Height="18" Foreground="#64748B"
                                                                                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>

                                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" 
                                               Focusable="False" PopupAnimation="Slide">
                                            <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                <Border x:Name="DropDownBorder" Background="White" BorderThickness="1" BorderBrush="#D0D0D0" CornerRadius="4"
                                                        Effect="{DynamicResource MaterialDesignShadowDepth1}">
                                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                                    </ScrollViewer>
                                                </Border>
                                            </Grid>
                                        </Popup>
                                    </Grid>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                </Trigger>
                                <Trigger Property="IsGrouping" Value="True">
                                    <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>



            <!-- Modern PasswordBox -->

            <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">

                <Setter Property="Height" Value="40"/>

                <Setter Property="VerticalContentAlignment" Value="Center"/>

                <Setter Property="Padding" Value="10 0"/>

                <Setter Property="BorderThickness" Value="1"/>

                <Setter Property="BorderBrush" Value="#D0D0D0"/>

                <Setter Property="Background" Value="White"/>

                <Setter Property="FontSize" Value="14"/>

                <Setter Property="Template">

                    <Setter.Value>

                        <ControlTemplate TargetType="PasswordBox">

                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 

                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">

                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver" Value="True">

                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>

                                </Trigger>

                                <Trigger Property="IsKeyboardFocused" Value="True">

                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>

                                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Setter.Value>

                </Setter>

            </Style>



            <!-- Modern Filter Pill ComboBox Style (Dùng chung cho toàn bộ ứng dụng) -->

            <Style x:Key="FilterPillComboBox" TargetType="ComboBox">

                <Setter Property="Height" Value="40"/>

                <Setter Property="VerticalContentAlignment" Value="Center"/>

                <Setter Property="Padding" Value="14 0 32 0"/>

                <Setter Property="BorderThickness" Value="1.5"/>

                <Setter Property="BorderBrush" Value="#CBD5E1"/>

                <Setter Property="Background" Value="White"/>

                <Setter Property="FontSize" Value="13.5"/>

                <Setter Property="Foreground" Value="#1E293B"/>

                <Setter Property="FontWeight" Value="Medium"/>

                <Setter Property="Cursor" Value="Hand"/>

                <Setter Property="ItemContainerStyle">

                    <Setter.Value>

                        <Style TargetType="ComboBoxItem">

                            <Setter Property="Padding" Value="14,10"/>

                            <Setter Property="FontSize" Value="13.5"/>

                            <Setter Property="Foreground" Value="#1E293B"/>

                            <Setter Property="Cursor" Value="Hand"/>

                            <Setter Property="SnapsToDevicePixels" Value="True"/>

                            <Setter Property="Template">

                                <Setter.Value>

                                    <ControlTemplate TargetType="ComboBoxItem">

                                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8" 

                                                Padding="{TemplateBinding Padding}" Margin="0,2">

                                            <ContentPresenter VerticalAlignment="Center"/>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">

                                                <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9"/>

                                                <Setter Property="Foreground" Value="#0F172A"/>

                                            </Trigger>

                                            <Trigger Property="IsSelected" Value="True">

                                                <Setter TargetName="ItemBorder" Property="Background" Value="#E0F2FE"/>

                                                <Setter Property="Foreground" Value="#0284C7"/>

                                                <Setter Property="FontWeight" Value="SemiBold"/>

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </Setter.Value>

                            </Setter>

                        </Style>

                    </Setter.Value>

                </Setter>

                <Setter Property="Template">

                    <Setter.Value>

                        <ControlTemplate TargetType="ComboBox">

                            <Grid>

                                <Border x:Name="MainBorder" ToolTip="{Binding Path=SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Background}" 

                                        BorderBrush="{TemplateBinding BorderBrush}" 

                                        BorderThickness="{TemplateBinding BorderThickness}" 

                                        CornerRadius="20">

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="38"/>

                                        </Grid.ColumnDefinitions>

                                        

                                        <!-- Text Area strictly contained with balanced 32px margins for perfect centering -->

                                        <Grid Grid.ColumnSpan="2" Margin="16,0,34,0" VerticalAlignment="Center" ClipToBounds="True">

                                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"

                                                              Content="{TemplateBinding SelectionBoxItem}"

                                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"

                                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"

                                                              VerticalAlignment="Center"

                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">

                                                <ContentPresenter.Resources>

                                                    <Style TargetType="TextBlock">

                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>

                                                    </Style>

                                                </ContentPresenter.Resources>

                                            </ContentPresenter>



                                            <TextBlock x:Name="Placeholder"

                                                       Text="{TemplateBinding materialDesign:HintAssist.Hint}"

                                                       VerticalAlignment="Center" HorizontalAlignment="Left"

                                                       Foreground="#94A3B8" IsHitTestVisible="False"

                                                       FontSize="{TemplateBinding FontSize}"

                                                       TextTrimming="CharacterEllipsis"

                                                       Visibility="Collapsed"/>

                                        </Grid>

                                        

                                        <!-- Full clickable ToggleButton spanning entire ComboBox -->

                                        <ToggleButton x:Name="toggleButton"

                                                      Grid.Column="0"

                                                      Grid.ColumnSpan="2"

                                                      Focusable="False"

                                                      ClickMode="Press"

                                                      HorizontalAlignment="Stretch"

                                                      VerticalAlignment="Stretch"

                                                      HorizontalContentAlignment="Stretch"

                                                      VerticalContentAlignment="Stretch"

                                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"

                                                      Background="Transparent"

                                                      BorderThickness="0"

                                                      Cursor="Hand">

                                            <ToggleButton.Style>

                                                <Style TargetType="ToggleButton">

                                                    <Setter Property="OverridesDefaultStyle" Value="True"/>

                                                    <Setter Property="Background" Value="Transparent"/>

                                                    <Setter Property="BorderThickness" Value="0"/>

                                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>

                                                    <Setter Property="VerticalAlignment" Value="Stretch"/>

                                                    <Setter Property="Template">

                                                        <Setter.Value>

                                                            <ControlTemplate TargetType="ToggleButton">

                                                                <Border Background="Transparent" 

                                                                        HorizontalAlignment="Stretch" 

                                                                        VerticalAlignment="Stretch">

                                                                    <materialDesign:PackIcon Kind="ChevronDown" 

                                                                                             Width="18" Height="18" 

                                                                                             Foreground="#64748B"

                                                                                             HorizontalAlignment="Right" 

                                                                                             VerticalAlignment="Center" 

                                                                                             Margin="0,0,14,0"/>

                                                                </Border>

                                                            </ControlTemplate>

                                                        </Setter.Value>

                                                    </Setter>

                                                </Style>

                                            </ToggleButton.Style>

                                        </ToggleButton>



                                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" 

                                               Focusable="False" PopupAnimation="Slide" VerticalOffset="4">

                                            <Grid x:Name="DropDown" SnapsToDevicePixels="True" 

                                                  MinWidth="{Binding ActualWidth, ElementName=MainBorder}" 

                                                  MaxHeight="320">

                                                <Border x:Name="DropDownBorder" Background="White" CornerRadius="12" 

                                                        BorderThickness="1" BorderBrush="#E2E8F0" Padding="6">

                                                    <Border.Effect>

                                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.12"/>

                                                    </Border.Effect>

                                                    <ScrollViewer SnapsToDevicePixels="True" MaxHeight="300">

                                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />

                                                    </ScrollViewer>

                                                </Border>

                                            </Grid>

                                        </Popup>

                                    </Grid>

                                </Border>

                            </Grid>

                            <ControlTemplate.Triggers>

                                <MultiTrigger>

                                    <MultiTrigger.Conditions>

                                        <Condition Property="SelectedItem" Value="{x:Null}"/>

                                        <Condition Property="Text" Value=""/>

                                    </MultiTrigger.Conditions>

                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>

                                </MultiTrigger>

                                <Trigger Property="IsMouseOver" Value="True">

                                    <Setter TargetName="MainBorder" Property="BorderBrush" Value="#94A3B8"/>

                                </Trigger>

                                <Trigger Property="IsKeyboardFocusWithin" Value="True">

                                    <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>

                                    <Setter TargetName="MainBorder" Property="BorderThickness" Value="2"/>

                                </Trigger>

                                <Trigger Property="IsDropDownOpen" Value="True">

                                    <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>

                                    <Setter TargetName="MainBorder" Property="BorderThickness" Value="2"/>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Setter.Value>

                </Setter>

            </Style>



            <!-- Modern Filter Pill DatePicker Style (Dùng chung cho toàn bộ ứng dụng) -->
            <Style x:Key="FilterPillDatePicker" TargetType="DatePicker">
                <Setter Property="Language" Value="vi-VN"/>
                <Setter Property="helpers:DatePickerHelper.FixCalendarLocale" Value="True"/>
                <Setter Property="helpers:DatePickerHelper.EnableSmartDateEntry" Value="True"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#1E293B"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="CalendarStyle" Value="{StaticResource ModernCalendarStyle}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DatePicker">
                            <Border x:Name="border" Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Date Input Box exactly centered horizontally by balancing margins -->
                                    <DatePickerTextBox x:Name="PART_TextBox" 
                                                       Grid.Column="0"
                                                       Grid.ColumnSpan="2"
                                                       HorizontalContentAlignment="Center"
                                                       VerticalContentAlignment="Center"
                                                       TextAlignment="Center"
                                                       Background="Transparent" 
                                                       BorderThickness="0"
                                                       Margin="34 0 34 0"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       FontWeight="{TemplateBinding FontWeight}"
                                                       FontSize="{TemplateBinding FontSize}"
                                                       Focusable="True">
                                        <DatePickerTextBox.Template>
                                            <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                                                <Grid>
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  HorizontalAlignment="Center"
                                                                  HorizontalContentAlignment="Center"
                                                                  VerticalContentAlignment="Center" />
                                                    <TextBlock x:Name="Watermark" Text="dd/MM/yyyy" 
                                                               IsHitTestVisible="False" 
                                                               Foreground="#94A3B8"
                                                               VerticalAlignment="Center" 
                                                               HorizontalAlignment="Center"
                                                               TextAlignment="Center"
                                                               FontSize="{TemplateBinding FontSize}"
                                                               Visibility="Hidden"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </DatePickerTextBox.Template>
                                    </DatePickerTextBox>

                                    <!-- Calendar Icon Button at Right -->
                                    <Button x:Name="PART_Button" 
                                            Grid.Column="1" 
                                            Width="30"
                                            Height="30"
                                            Padding="0"
                                            Margin="0 0 4 0"
                                            Background="Transparent" 
                                            BorderThickness="0"
                                            Foreground="#64748B"
                                            Cursor="Hand"
                                            Focusable="False"
                                            Style="{DynamicResource MaterialDesignToolButton}"
                                            ToolTip="Chọn ngày từ lịch">
                                        <materialDesign:PackIcon Kind="CalendarMonthOutline" Width="18" Height="18"/>
                                    </Button>

                                    <!-- Modern Popup with fade animation and transparency -->
                                    <Popup x:Name="PART_Popup" 
                                           AllowsTransparency="True" 
                                           Placement="Bottom" 
                                           VerticalOffset="6"
                                           PopupAnimation="Fade"
                                           StaysOpen="False"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>

    </Application.Resources>

</Application>

