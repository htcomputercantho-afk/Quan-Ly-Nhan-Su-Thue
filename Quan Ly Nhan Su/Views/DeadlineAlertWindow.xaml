<Window x:Class="TaxPersonnelManagement.Views.DeadlineAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        SizeToContent="Height" Width="720"
        MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Title="Cảnh báo đến hạn">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                    <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,20,0,-20" To="0" Duration="0:0:0.25">
                        <ThicknessAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </ThicknessAnimation.EasingFunction>
                    </ThicknessAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border Background="White" CornerRadius="18" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="35" ShadowDepth="6" Opacity="0.22" Color="#B45309"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Gradient Header (Amber/Orange) -->
            <Border Grid.Row="0" CornerRadius="18,18,0,0" Padding="22,18" MouseDown="Header_MouseDown" Cursor="SizeAll">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#92400E" Offset="0"/>
                        <GradientStop Color="#B45309" Offset="0.5"/>
                        <GradientStop Color="#D97706" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#26FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ClockAlertOutline" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Cảnh Báo Đến Hạn Nhân Sự" FontSize="16.5" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="txtSubtitle" FontSize="12.5" Foreground="#FDE68A" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Click="Close_Click" Width="30" Height="30" Cursor="Hand"
                            Background="#22FFFFFF" BorderThickness="0" Foreground="White"
                            materialDesign:ButtonAssist.CornerRadius="15" Padding="0" ToolTip="Đóng">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Table -->
            <Grid Grid.Row="1" Margin="22,16,22,10">
                <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Background="White" ClipToBounds="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="390">
                        <DataGrid x:Name="dgDeadlines"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9"
                                  Background="White" RowBackground="White"
                                  AlternatingRowBackground="#FFFBF5"
                                  BorderThickness="0" CanUserResizeRows="False"
                                  CanUserSortColumns="False" SelectionMode="Single" RowHeight="54">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#FFF8F0"/>
                                    <Setter Property="Foreground" Value="#92400E"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="10,10"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#FDE68A"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#FFFBEB"/>
                                            <Setter Property="Foreground" Value="#78350F"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <!-- STT -->
                                <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="52">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!-- Họ tên & Bộ phận -->
                                <DataGridTemplateColumn Header="Họ và tên / Đơn vị" Width="*">
                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#FFF8F0"/>
                                            <Setter Property="Foreground" Value="#92400E"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="Padding" Value="16,10,10,10"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush" Value="#FDE68A"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                        </Style>
                                    </DataGridTemplateColumn.HeaderStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="13.5" Foreground="#1E293B"/>
                                                <TextBlock Text="{Binding DepartmentDisplay}" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Loại cảnh báo -->
                                <DataGridTemplateColumn Header="Loại" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Background="{Binding AlertCategoryBackground}">
                                                <TextBlock Text="{Binding AlertCategoryDisplay}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{Binding AlertCategoryForeground}" TextAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Ngày đến hạn -->
                                <DataGridTemplateColumn Header="Ngày đến hạn" Width="145">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="CalendarClock" Width="16" Height="16" Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding DeadlineDateDisplay}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Còn lại -->
                                <DataGridTemplateColumn Header="Thời gian" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="12" Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Background="{Binding DaysLeftBackground}"
                                                    BorderBrush="{Binding DaysLeftBorder}" BorderThickness="1">
                                                <TextBlock Text="{Binding DaysLeftDisplay}" FontSize="11.5" FontWeight="Bold"
                                                           Foreground="{Binding DaysLeftForeground}" TextAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="22,12,22,18" Background="#FFFBF0" CornerRadius="0,0,18,18" BorderBrush="#FDE68A" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock FontSize="12" Foreground="#92400E">
                            <Run FontWeight="Bold" Foreground="#7E22CE">🟣 Hết hạn bảo lưu PC:</Run><Run> Cảnh báo trước 30 ngày</Run><Run>  |  </Run>
                            <Run FontWeight="Bold" Foreground="#B45309">🟡 Nâng lương:</Run><Run> Cảnh báo trước 60 ngày</Run>
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="#92400E" Margin="0,3,0,0">
                            <Run FontWeight="Bold" Foreground="#B91C1C">🔴 Nghỉ hưu</Run><Run> / </Run>
                            <Run FontWeight="Bold" Foreground="#1D4ED8">🔵 Bổ nhiệm:</Run><Run> Cảnh báo trước 90 ngày</Run>
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="#78350F" Margin="0,4,0,0">
                            <Run FontStyle="Italic">* Hạn bổ nhiệm được ước tính: Ngày QĐ bổ nhiệm + 5 năm (áp dụng cấp Trưởng/Phó).</Run>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Đã hiểu" Click="Close_Click"
                            Width="120" Height="38" Cursor="Hand"
                            Style="{DynamicResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="19"
                            Background="#D97706" BorderBrush="#D97706" Foreground="White"
                            FontSize="13.5" FontWeight="Bold">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="8" Opacity="0.25" Color="#D97706" ShadowDepth="2"/>
                        </Button.Effect>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
