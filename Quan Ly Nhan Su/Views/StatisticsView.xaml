<UserControl x:Class="TaxPersonnelManagement.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:TaxPersonnelManagement.Views"
             mc:Ignorable="d" 
             Language="vi-VN"
             d:DesignHeight="750" d:DesignWidth="1200">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ComboBox.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Shadows.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Button.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Text styling utilities -->
            <Style x:Key="CardTitleText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppHeadingFont}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="ChartSectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#374151"/>
                <Setter Property="Margin" Value="0 0 0 10"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="Auto"/> <!-- Filter Bar -->
            <RowDefinition Height="*"/>    <!-- Scrollable Content -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 15">
            <materialDesign:PackIcon Kind="ChartPie" Width="28" Height="28" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0 0 10 0"/>
            <TextBlock Text="BÁO CÁO THỐNG KÊ NHÂN SỰ" FontFamily="{StaticResource AppHeadingFont}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 2. Filter Toolbar -->
        <materialDesign:Card Grid.Row="1" Margin="0 0 0 15" Padding="20 14" UniformCornerRadius="12" Background="White" Effect="{DynamicResource MaterialDesignShadowDepth1}">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Bộ phận -->
                <ComboBox x:Name="cbDepartmentFilter" Width="380" Margin="0 0 16 0"
                          Style="{StaticResource FilterPillComboBox}"
                          SelectionChanged="Filter_Changed"/>

                <!-- Năm thống kê -->
                <ComboBox x:Name="cbYearFilter" Width="150" Margin="0 0 20 0"
                          Style="{StaticResource FilterPillComboBox}"
                          SelectionChanged="Filter_Changed"/>

                <!-- Export Excel Button -->
                <StackPanel VerticalAlignment="Bottom" Margin="0 0 0 0">
                    <Button x:Name="btnExportExcel" Height="40" Padding="18 0"
                            Background="#15803D" BorderBrush="#15803D" Foreground="White"
                            materialDesign:ButtonAssist.CornerRadius="20"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="btnExportExcel_Click" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExcel" Width="18" Height="18" VerticalAlignment="Center" Margin="0 0 8 0"/>
                            <TextBlock Text="Xuất Excel" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </WrapPanel>
        </materialDesign:Card>

        <!-- 3. Scrollable Content -->
        <ScrollViewer x:Name="mainScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0 0 5 0">
            <StackPanel>
                
                <!-- ROW 1: KPI Cards -->
                <Grid Margin="0 0 0 15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Total Personnel -->
                    <materialDesign:Card Grid.Column="0" Margin="0 0 10 0" Padding="20" UniformCornerRadius="12">
                        <materialDesign:Card.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0D47A1" Offset="0"/>
                                <GradientStop Color="#1976D2" Offset="1"/>
                            </LinearGradientBrush>
                        </materialDesign:Card.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="AccountGroup" Width="56" Height="56" Foreground="White" Opacity="0.85" VerticalAlignment="Center" Grid.Column="0"/>
                            <StackPanel Grid.Column="1" Margin="20 0 0 0" VerticalAlignment="Center">
                                <TextBlock Text="TỔNG SỐ CÔNG CHỨC" FontFamily="{StaticResource AppHeadingFont}" Foreground="White" Opacity="0.9" FontSize="13" FontWeight="Bold"/>
                                <TextBlock x:Name="txtTotalPersonnel" Text="0" Foreground="White" FontSize="36" FontWeight="Black" Margin="0 4 0 0"/>
                                <TextBlock Text="Đang công tác tại đơn vị" Foreground="White" Opacity="0.7" FontSize="11" Margin="0 2 0 0"/>
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Card 2: Gender Distribution -->
                    <materialDesign:Card Grid.Column="1" Margin="10 0 0 0" Padding="20" UniformCornerRadius="12" Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Male Segment -->
                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="GenderMale" Width="44" Height="44" Foreground="#0288D1" VerticalAlignment="Center" Grid.Column="0" Margin="0 0 15 0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="NAM CÔNG CHỨC" FontFamily="{StaticResource AppHeadingFont}" FontSize="12" FontWeight="Bold" Foreground="Gray"/>
                                    <TextBlock x:Name="txtMaleCount" Text="0 người" FontSize="20" FontWeight="Bold" Foreground="#0288D1" Margin="0 4 0 0"/>
                                    <TextBlock x:Name="txtMaleRatio" Text="Tỷ lệ: 0%" FontSize="13" Foreground="#555" FontWeight="Medium" Margin="0 2 0 0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Separator -->
                            <Separator Grid.Column="1" Style="{StaticResource {x:Static MenuItem.SeparatorStyleKey}}" Margin="15 0">
                                <Separator.LayoutTransform>
                                    <RotateTransform Angle="90" />
                                </Separator.LayoutTransform>
                            </Separator>

                            <!-- Female Segment -->
                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="GenderFemale" Width="44" Height="44" Foreground="#EC407A" VerticalAlignment="Center" Grid.Column="0" Margin="0 0 15 0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="NỮ CÔNG CHỨC" FontFamily="{StaticResource AppHeadingFont}" FontSize="12" FontWeight="Bold" Foreground="Gray"/>
                                    <TextBlock x:Name="txtFemaleCount" Text="0 người" FontSize="20" FontWeight="Bold" Foreground="#EC407A" Margin="0 4 0 0"/>
                                    <TextBlock x:Name="txtFemaleRatio" Text="Tỷ lệ: 0%" FontSize="13" Foreground="#555" FontWeight="Medium" Margin="0 2 0 0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </materialDesign:Card>
                </Grid>

                <!-- ROW 2: Pie/Donut Charts (Education & Party Member) -->
                <Grid Margin="0 0 0 15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Chart 1: Education -->
                    <materialDesign:Card Grid.Column="0" Margin="0 0 10 0" Padding="20" UniformCornerRadius="12" Background="White">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0 0 0 15">
                                <materialDesign:PackIcon Kind="School" Width="22" Height="22" Foreground="#7B1FA2" VerticalAlignment="Center" Margin="0 0 8 0"/>
                                <TextBlock Text="TRÌNH ĐỘ HỌC VẤN" Style="{StaticResource CardTitleText}" Foreground="#7B1FA2"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0 10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Donut Chart Wrap -->
                                <Grid Grid.Column="0" Width="170" Height="170" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas x:Name="cvEducation" Width="170" Height="170"/>
                                    <!-- Center info -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="txtEduCenterCount" Text="0" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#374151"/>
                                        <TextBlock Text="Cán bộ" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Legends -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="25 0 0 0">
                                    <!-- Sau Đại học -->
                                    <Grid Margin="0 0 0 12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="12" Height="12" Background="#7B1FA2" CornerRadius="3" VerticalAlignment="Center" Margin="0 0 10 0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="Sau Đại học: " FontSize="13" Foreground="#4B5563"/>
                                            <TextBlock x:Name="txtPostGradCount" Text="0" FontWeight="Bold" FontSize="13" Foreground="#1F2937"/>
                                            <TextBlock x:Name="txtPostGradRatio" Text=" (0%)" FontSize="12" Foreground="#6B7280"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Đại học -->
                                    <Grid Margin="0 0 0 12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="12" Height="12" Background="#1565C0" CornerRadius="3" VerticalAlignment="Center" Margin="0 0 10 0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="Đại học: " FontSize="13" Foreground="#4B5563"/>
                                            <TextBlock x:Name="txtGradCount" Text="0" FontWeight="Bold" FontSize="13" Foreground="#1F2937"/>
                                            <TextBlock x:Name="txtGradRatio" Text=" (0%)" FontSize="12" Foreground="#6B7280"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Khác -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="12" Height="12" Background="#78909C" CornerRadius="3" VerticalAlignment="Center" Margin="0 0 10 0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="Trình độ khác: " FontSize="13" Foreground="#4B5563"/>
                                            <TextBlock x:Name="txtOtherEduCount" Text="0" FontWeight="Bold" FontSize="13" Foreground="#1F2937"/>
                                            <TextBlock x:Name="txtOtherEduRatio" Text=" (0%)" FontSize="12" Foreground="#6B7280"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Summary Text -->
                            <Border Grid.Row="2" Background="#F9FAFB" CornerRadius="6" Padding="12 10" Margin="0 10 0 0">
                                <TextBlock x:Name="txtEducationSummary" FontSize="12.5" TextWrapping="Wrap" Foreground="#475569" FontStyle="Italic" LineHeight="18"/>
                            </Border>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Chart 2: Party Member -->
                    <materialDesign:Card Grid.Column="1" Margin="10 0 0 0" Padding="20" UniformCornerRadius="12" Background="White">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0 0 0 15">
                                <materialDesign:PackIcon Kind="Flag" Width="22" Height="22" Foreground="#D32F2F" VerticalAlignment="Center" Margin="0 0 8 0"/>
                                <TextBlock Text="PHÂN BỐ ĐẢNG VIÊN" Style="{StaticResource CardTitleText}" Foreground="#D32F2F"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0 10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Donut Chart Wrap -->
                                <Grid Grid.Column="0" Width="170" Height="170" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas x:Name="cvParty" Width="170" Height="170"/>
                                    <!-- Center info -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="txtPartyCenterCount" Text="0" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#374151"/>
                                        <TextBlock Text="Cán bộ" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Legends -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="25 0 0 0">
                                    <!-- Đảng viên -->
                                    <Grid Margin="0 0 0 12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="12" Height="12" Background="#D32F2F" CornerRadius="3" VerticalAlignment="Center" Margin="0 0 10 0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="Đảng viên: " FontSize="13" Foreground="#4B5563"/>
                                            <TextBlock x:Name="txtPartyMemberCount" Text="0" FontWeight="Bold" FontSize="13" Foreground="#1F2937"/>
                                            <TextBlock x:Name="txtPartyMemberRatio" Text=" (0%)" FontSize="12" Foreground="#6B7280"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Chưa là Đảng viên -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="12" Height="12" Background="#FFA000" CornerRadius="3" VerticalAlignment="Center" Margin="0 0 10 0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="Chưa là Đảng viên: " FontSize="13" Foreground="#4B5563"/>
                                            <TextBlock x:Name="txtNonPartyCount" Text="0" FontWeight="Bold" FontSize="13" Foreground="#1F2937"/>
                                            <TextBlock x:Name="txtNonPartyRatio" Text=" (0%)" FontSize="12" Foreground="#6B7280"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Summary Text -->
                            <Border Grid.Row="2" Background="#F9FAFB" CornerRadius="6" Padding="12 10" Margin="0 10 0 0">
                                <TextBlock x:Name="txtPartySummary" FontSize="12.5" TextWrapping="Wrap" Foreground="#475569" FontStyle="Italic" LineHeight="18"/>
                            </Border>
                        </Grid>
                    </materialDesign:Card>
                </Grid>

                <!-- ROW 3: Bar Charts (Age & Seniority) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Chart 3: Age Distribution -->
                    <materialDesign:Card Grid.Column="0" Margin="0 0 10 0" Padding="20" UniformCornerRadius="12" Background="White">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0 0 0 15">
                                <materialDesign:PackIcon Kind="AccountClock" Width="22" Height="22" Foreground="#00796B" VerticalAlignment="Center" Margin="0 0 8 0"/>
                                <TextBlock Text="PHÂN BỐ ĐỘ TUỔI" Style="{StaticResource CardTitleText}" Foreground="#00796B"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Height="170" Margin="0 10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Column 1: Under 30 -->
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="txtAgeVal1" Grid.Row="0" Text="0 (0%)" FontSize="11.5" HorizontalAlignment="Center" Margin="0 0 0 4" FontWeight="SemiBold" Foreground="#374151"/>
                                    <Border Grid.Row="1" Width="32" Height="120" Background="#F3F4F6" CornerRadius="6" VerticalAlignment="Bottom">
                                        <Border x:Name="barAge1" Width="32" Height="0" CornerRadius="6" VerticalAlignment="Bottom">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#4DB6AC" Offset="0"/>
                                                    <GradientStop Color="#00796B" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                    <TextBlock Grid.Row="2" Text="Dưới 30" FontSize="12" HorizontalAlignment="Center" Margin="0 6 0 0" Foreground="#4B5563" FontWeight="Medium"/>
                                </Grid>

                                <!-- Column 2: 30 - 40 -->
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="txtAgeVal2" Grid.Row="0" Text="0 (0%)" FontSize="11.5" HorizontalAlignment="Center" Margin="0 0 0 4" FontWeight="SemiBold" Foreground="#374151"/>
                                    <Border Grid.Row="1" Width="32" Height="120" Background="#F3F4F6" CornerRadius="6" VerticalAlignment="Bottom">
                                        <Border x:Name="barAge2" Width="32" Height="0" CornerRadius="6" VerticalAlignment="Bottom">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#4DB6AC" Offset="0"/>
                                                    <GradientStop Color="#00796B" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                    <TextBlock Grid.Row="2" Text="30 - 40" FontSize="12" HorizontalAlignment="Center" Margin="0 6 0 0" Foreground="#4B5563" FontWeight="Medium"/>
                                </Grid>

                                <!-- Column 3: 41 - 50 -->
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="txtAgeVal3" Grid.Row="0" Text="0 (0%)" FontSize="11.5" HorizontalAlignment="Center" Margin="0 0 0 4" FontWeight="SemiBold" Foreground="#374151"/>
                                    <Border Grid.Row="1" Width="32" Height="120" Background="#F3F4F6" CornerRadius="6" VerticalAlignment="Bottom">
                                        <Border x:Name="barAge3" Width="32" Height="0" CornerRadius="6" VerticalAlignment="Bottom">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#4DB6AC" Offset="0"/>
                                                    <GradientStop Color="#00796B" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                    <TextBlock Grid.Row="2" Text="41 - 50" FontSize="12" HorizontalAlignment="Center" Margin="0 6 0 0" Foreground="#4B5563" FontWeight="Medium"/>
                                </Grid>

                                <!-- Column 4: Over 50 -->
                                <Grid Grid.Column="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="txtAgeVal4" Grid.Row="0" Text="0 (0%)" FontSize="11.5" HorizontalAlignment="Center" Margin="0 0 0 4" FontWeight="SemiBold" Foreground="#374151"/>
                                    <Border Grid.Row="1" Width="32" Height="120" Background="#F3F4F6" CornerRadius="6" VerticalAlignment="Bottom">
                                        <Border x:Name="barAge4" Width="32" Height="0" CornerRadius="6" VerticalAlignment="Bottom">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#4DB6AC" Offset="0"/>
                                                    <GradientStop Color="#00796B" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                    <TextBlock Grid.Row="2" Text="Trên 50" FontSize="12" HorizontalAlignment="Center" Margin="0 6 0 0" Foreground="#4B5563" FontWeight="Medium"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Chart 4: Seniority Distribution -->
                    <materialDesign:Card Grid.Column="1" Margin="10 0 0 0" Padding="20" UniformCornerRadius="12" Background="White">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0 0 0 15">
                                <materialDesign:PackIcon Kind="Timer" Width="22" Height="22" Foreground="#303F9F" VerticalAlignment="Center" Margin="0 0 8 0"/>
                                <TextBlock Text="PHÂN BỐ THÂM NIÊN CÔNG TÁC" Style="{StaticResource CardTitleText}" Foreground="#303F9F"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Height="170" Margin="0 10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Column 1: Under 5 years -->
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="txtSenVal1" Grid.Row="0" Text="0 (0%)" FontSize="11.5" HorizontalAlignment="Center" Margin="0 0 0 4" FontWeight="SemiBold" Foreground="#374151"/>
                                    <Border Grid.Row="1" Width="32" Height="120" Background="#F3F4F6" CornerRadius="6" VerticalAlignment="Bottom">
                                        <Border x:Name="barSen1" Width="32" Height="0" CornerRadius="6" VerticalAlignment="Bottom">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#7986CB" Offset="0"/>
                                                    <GradientStop Color="#303F9F" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                    <TextBlock Grid.Row="2" Text="Dưới 5 năm" FontSize="11" HorizontalAlignment="Center" Margin="0 6 0 0" Foreground="#4B5563" FontWeight="Medium"/>
                                </Grid>

                                <!-- Column 2: 5 - 10 years -->
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="txtSenVal2" Grid.Row="0" Text="0 (0%)" FontSize="11.5" HorizontalAlignment="Center" Margin="0 0 0 4" FontWeight="SemiBold" Foreground="#374151"/>
                                    <Border Grid.Row="1" Width="32" Height="120" Background="#F3F4F6" CornerRadius="6" VerticalAlignment="Bottom">
                                        <Border x:Name="barSen2" Width="32" Height="0" CornerRadius="6" VerticalAlignment="Bottom">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#7986CB" Offset="0"/>
                                                    <GradientStop Color="#303F9F" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                    <TextBlock Grid.Row="2" Text="5 - 10 năm" FontSize="11" HorizontalAlignment="Center" Margin="0 6 0 0" Foreground="#4B5563" FontWeight="Medium"/>
                                </Grid>

                                <!-- Column 3: 11 - 20 years -->
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="txtSenVal3" Grid.Row="0" Text="0 (0%)" FontSize="11.5" HorizontalAlignment="Center" Margin="0 0 0 4" FontWeight="SemiBold" Foreground="#374151"/>
                                    <Border Grid.Row="1" Width="32" Height="120" Background="#F3F4F6" CornerRadius="6" VerticalAlignment="Bottom">
                                        <Border x:Name="barSen3" Width="32" Height="0" CornerRadius="6" VerticalAlignment="Bottom">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#7986CB" Offset="0"/>
                                                    <GradientStop Color="#303F9F" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                    <TextBlock Grid.Row="2" Text="11 - 20 năm" FontSize="11" HorizontalAlignment="Center" Margin="0 6 0 0" Foreground="#4B5563" FontWeight="Medium"/>
                                </Grid>

                                <!-- Column 4: Over 20 years -->
                                <Grid Grid.Column="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="txtSenVal4" Grid.Row="0" Text="0 (0%)" FontSize="11.5" HorizontalAlignment="Center" Margin="0 0 0 4" FontWeight="SemiBold" Foreground="#374151"/>
                                    <Border Grid.Row="1" Width="32" Height="120" Background="#F3F4F6" CornerRadius="6" VerticalAlignment="Bottom">
                                        <Border x:Name="barSen4" Width="32" Height="0" CornerRadius="6" VerticalAlignment="Bottom">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#7986CB" Offset="0"/>
                                                    <GradientStop Color="#303F9F" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                    <TextBlock Grid.Row="2" Text="Trên 20 năm" FontSize="11" HorizontalAlignment="Center" Margin="0 6 0 0" Foreground="#4B5563" FontWeight="Medium"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </materialDesign:Card>
                </Grid>

            <!-- ═══ THỐNG KÊ CÁC NGẠCH CÔNG CHỨC ═══ -->
            <StackPanel Margin="0,16,0,0">
                <materialDesign:Card Padding="22" UniformCornerRadius="12" Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="CertificateOutline" Width="24" Height="24" Foreground="#4338CA" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="THỐNG KÊ CÁC NGẠCH CÔNG CHỨC" Style="{StaticResource CardTitleText}" Foreground="#4338CA"/>
                        </StackPanel>

                        <!-- Scrollable Table Container for Small Screens -->
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="InnerScrollViewer_PreviewMouseWheel">
                            <Grid MinWidth="750">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Column Headers -->
                                <Border Grid.Row="0" Background="#EEF2FF" CornerRadius="8" Padding="14,8" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*" MinWidth="180"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="STT" FontFamily="{StaticResource AppHeadingFont}" FontWeight="Bold" FontSize="12.5" Foreground="#4338CA" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="MÃ NGẠCH" FontFamily="{StaticResource AppHeadingFont}" FontWeight="Bold" FontSize="12.5" Foreground="#4338CA" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="TÊN NGẠCH CÔNG CHỨC" FontFamily="{StaticResource AppHeadingFont}" FontWeight="Bold" FontSize="12.5" Foreground="#4338CA"/>
                                        <TextBlock Grid.Column="3" Text="NAM" FontFamily="{StaticResource AppHeadingFont}" FontWeight="Bold" FontSize="12.5" Foreground="#4338CA" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="NỮ" FontFamily="{StaticResource AppHeadingFont}" FontWeight="Bold" FontSize="12.5" Foreground="#4338CA" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="TỔNG (NGƯỜI)" FontFamily="{StaticResource AppHeadingFont}" FontWeight="Bold" FontSize="12.5" Foreground="#4338CA" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="TỶ LỆ (%)" FontFamily="{StaticResource AppHeadingFont}" FontWeight="Bold" FontSize="12.5" Foreground="#4338CA" TextAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Data Rows (generated dynamically) -->
                                <ItemsControl x:Name="icRankStatistics" Grid.Row="1">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="14,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*" MinWidth="180"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="160"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- STT -->
                                                    <TextBlock Grid.Column="0" Text="{Binding STT}" FontSize="12.5" Foreground="#6B7280" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    <!-- Mã ngạch -->
                                                    <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RankCode}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" TextAlignment="Center"/>
                                                    </Border>
                                                    <!-- Tên ngạch -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="8" Height="8" Background="#6366F1" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding RankName}" FontSize="13" FontWeight="SemiBold" Foreground="#1F2937" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <!-- Nam -->
                                                    <TextBlock Grid.Column="3" Text="{Binding MaleCount}" FontSize="13" FontWeight="Bold" Foreground="#0288D1" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    <!-- Nữ -->
                                                    <TextBlock Grid.Column="4" Text="{Binding FemaleCount}" FontSize="13" FontWeight="Bold" Foreground="#EC407A" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    <!-- Tổng -->
                                                    <Border Grid.Column="5" Background="#EEF2FF" CornerRadius="6" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TotalCount}" FontSize="12.5" FontWeight="Bold" Foreground="#4338CA" TextAlignment="Center"/>
                                                    </Border>
                                                    <!-- Tỷ lệ (%) kèm thanh tiến độ -->
                                                    <Grid Grid.Column="6" VerticalAlignment="Center" Margin="10,0,10,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="48"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding RatioText}" FontSize="12" FontWeight="SemiBold" Foreground="#4B5563" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" CornerRadius="4" ClipToBounds="True" Background="#E2E8F0" Height="8" VerticalAlignment="Center">
                                                            <ProgressBar Value="{Binding BarRatio, Mode=OneWay}" Minimum="0" Maximum="100" Height="8" Foreground="#6366F1" Background="Transparent" BorderThickness="0"/>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Total Row (Footer) -->
                                <Border Grid.Row="2" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="0,1.5,0,0" Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*" MinWidth="180"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <materialDesign:PackIcon Kind="Sigma" Width="16" Height="16" Foreground="#4338CA" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="TỔNG CỘNG" FontFamily="{StaticResource AppHeadingFont}" FontWeight="Bold" FontSize="13" Foreground="#4338CA" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="txtRankTotalMale" Grid.Column="3" Text="0" FontSize="13" FontWeight="Black" Foreground="#0288D1" TextAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtRankTotalFemale" Grid.Column="4" Text="0" FontSize="13" FontWeight="Black" Foreground="#EC407A" TextAlignment="Center" VerticalAlignment="Center"/>
                                        <Border Grid.Column="5" Background="#4338CA" CornerRadius="6" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="txtRankTotalAll" Text="0" FontSize="12.5" FontWeight="Bold" Foreground="White" TextAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="6" Text="100.0%" FontSize="12.5" FontWeight="Bold" Foreground="#4338CA" TextAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ScrollViewer>

                        <!-- Summary Note -->
                        <Border Grid.Row="2" Background="#F9FAFB" CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
                            <TextBlock x:Name="txtRankSummary" FontSize="12.5" TextWrapping="Wrap" Foreground="#475569" FontStyle="Italic" LineHeight="18"/>
                        </Border>
                    </Grid>
                </materialDesign:Card>
            </StackPanel>

            <!-- ═══ THỐNG KÊ LÃNH ĐẠO THEO BỘ PHẬN ═══ -->
            <StackPanel Margin="0,16,0,20">
                <materialDesign:Card Padding="22" UniformCornerRadius="12" Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="AccountGroup" Width="22" Height="22" Foreground="#0F766E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="THỐNG KÊ LÃNH ĐẠO THEO BỘ PHẬN" Style="{StaticResource CardTitleText}" Foreground="#0F766E"/>
                        </StackPanel>

                        <!-- Container: Cố định cột STT và Bộ phận bên trái, cuộn ngang các cột chức danh bên phải -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <!-- Cột CỐ ĐỊNH (STT + BỘ PHẬN) -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Cột CUỘN NGANG (CÁC CHỨC DANH + TỔNG) -->
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 1. BẢNG CỐ ĐỊNH BÊN TRÁI -->
                            <Grid Grid.Column="0" Width="430">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header Cố Định -->
                                <Border Grid.Row="0" Background="#F0FDFA" CornerRadius="8,0,0,8" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="14,8" Margin="0,0,0,4" MinHeight="48">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="STT" FontFamily="{StaticResource AppHeadingFont}" FontWeight="Bold" FontSize="12.5" Foreground="#0F766E" TextAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="BỘ PHẬN" FontFamily="{StaticResource AppHeadingFont}" FontWeight="Bold" FontSize="12.5" Foreground="#0F766E" TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Dữ liệu hàng Cố Định -->
                                <ItemsControl x:Name="icTeamLeadershipLeft" Grid.Row="1">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E5E7EB" BorderThickness="0,0,1,1" Padding="14,0" Height="44">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- STT -->
                                                    <TextBlock Grid.Column="0" Text="{Binding STT}" FontSize="13" Foreground="#64748B" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                    <!-- Tên bộ phận / Tổ (Căn trái) -->
                                                    <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,6,0">
                                                        <Border DockPanel.Dock="Left" Width="8" Height="8" Background="#14B8A6" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DepartmentName}" FontSize="13" FontWeight="SemiBold" Foreground="#1F2937" 
                                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding DepartmentName}"/>
                                                    </DockPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Footer Tổng cộng Cố Định -->
                                <Border Grid.Row="2" Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="0,1.5,1,0" Padding="14,0" Height="44" Margin="0,2,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <materialDesign:PackIcon Kind="Sigma" Width="16" Height="16" Foreground="#0F766E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="TỔNG CỘNG" FontFamily="{StaticResource AppHeadingFont}" FontWeight="Bold" FontSize="13" Foreground="#0F766E" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 2. BẢNG CUỘN NGANG BÊN PHẢI (TỰ CO GIÃN THEO CHIỀU RỘNG MÀN HÌNH) -->
                            <ScrollViewer x:Name="svLeadership" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          PreviewMouseWheel="InnerScrollViewer_PreviewMouseWheel" SizeChanged="svLeadership_SizeChanged" Loaded="svLeadership_Loaded">
                                <Grid x:Name="gridLeadershipScrollContent" MinWidth="675">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Column Headers Cuộn -->
                                    <Border Grid.Row="0" Background="#F0FDFA" CornerRadius="0,8,8,0" Padding="14,8" Margin="0,0,0,4" MinHeight="48">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.3*" MinWidth="110"/>
                                                <ColumnDefinition Width="1.4*" MinWidth="115"/>
                                                <ColumnDefinition Width="1.1*" MinWidth="90"/>
                                                <ColumnDefinition Width="1.1*" MinWidth="95"/>
                                                <ColumnDefinition Width="1.1*" MinWidth="85"/>
                                                <ColumnDefinition Width="1*" MinWidth="75"/>
                                                <ColumnDefinition Width="1*" MinWidth="75"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="TRƯỞNG THUẾ CƠ SỞ" TextWrapping="Wrap" FontFamily="{StaticResource AppHeadingFont}" FontWeight="Bold" FontSize="11.5" Foreground="#0F766E" TextAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="PHÓ TRƯỞNG THUẾ CƠ SỞ" TextWrapping="Wrap" FontFamily="{StaticResource AppHeadingFont}" FontWeight="Bold" FontSize="11.5" Foreground="#0F766E" TextAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="TỔ TRƯỞNG" FontFamily="{StaticResource AppHeadingFont}" FontWeight="Bold" FontSize="12.5" Foreground="#0F766E" TextAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="PHÓ TỔ TRƯỞNG" FontFamily="{StaticResource AppHeadingFont}" FontWeight="Bold" FontSize="12.5" Foreground="#0F766E" TextAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="CÔNG CHỨC" FontFamily="{StaticResource AppHeadingFont}" FontWeight="Bold" FontSize="12.5" Foreground="#0F766E" TextAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="HĐLĐ" FontFamily="{StaticResource AppHeadingFont}" FontWeight="Bold" FontSize="12.5" Foreground="#0F766E" TextAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="6" Text="TỔNG" FontFamily="{StaticResource AppHeadingFont}" FontWeight="Bold" FontSize="12.5" Foreground="#0F766E" TextAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Data Rows Cuộn -->
                                    <ItemsControl x:Name="icTeamLeadership" Grid.Row="1">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="14,0" Height="44">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.3*" MinWidth="110"/>
                                                            <ColumnDefinition Width="1.4*" MinWidth="115"/>
                                                            <ColumnDefinition Width="1.1*" MinWidth="90"/>
                                                            <ColumnDefinition Width="1.1*" MinWidth="95"/>
                                                            <ColumnDefinition Width="1.1*" MinWidth="85"/>
                                                            <ColumnDefinition Width="1*" MinWidth="75"/>
                                                            <ColumnDefinition Width="1*" MinWidth="75"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Trưởng Thuế cơ sở -->
                                                        <TextBlock Grid.Column="0" Text="{Binding HeadCount}" FontSize="13" FontWeight="Bold" Foreground="#0D9488" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <!-- Phó Trưởng Thuế cơ sở -->
                                                        <TextBlock Grid.Column="1" Text="{Binding DeputyHeadCount}" FontSize="13" FontWeight="Bold" Foreground="#0284C7" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <!-- Tổ trưởng -->
                                                        <TextBlock Grid.Column="2" Text="{Binding LeaderCount}" FontSize="13" FontWeight="Bold" Foreground="#2563EB" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <!-- Phó Tổ trưởng -->
                                                        <TextBlock Grid.Column="3" Text="{Binding DeputyCount}" FontSize="13" FontWeight="Bold" Foreground="#7C3AED" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <!-- Công chức -->
                                                        <TextBlock Grid.Column="4" Text="{Binding StaffCount}" FontSize="13" Foreground="#374151" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <!-- HĐLĐ -->
                                                        <TextBlock Grid.Column="5" Text="{Binding ContractCount}" FontSize="13" FontWeight="Bold" Foreground="#D97706" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <!-- Tổng -->
                                                        <Border Grid.Column="6" Background="#F0FDFA" CornerRadius="6" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TotalCount}" FontSize="12.5" FontWeight="Bold" Foreground="#0F766E" TextAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Dòng Tổng cộng Cuộn -->
                                    <Border Grid.Row="2" Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="0,1.5,0,0" Padding="14,0" Height="44" Margin="0,2,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.3*" MinWidth="110"/>
                                                <ColumnDefinition Width="1.4*" MinWidth="115"/>
                                                <ColumnDefinition Width="1.1*" MinWidth="90"/>
                                                <ColumnDefinition Width="1.1*" MinWidth="95"/>
                                                <ColumnDefinition Width="1.1*" MinWidth="85"/>
                                                <ColumnDefinition Width="1*" MinWidth="75"/>
                                                <ColumnDefinition Width="1*" MinWidth="75"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="txtTeamTotalHead" Grid.Column="0" Text="0" FontSize="13" FontWeight="Black" Foreground="#0D9488" TextAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txtTeamTotalDeputyHead" Grid.Column="1" Text="0" FontSize="13" FontWeight="Black" Foreground="#0284C7" TextAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txtTeamTotalLeaders" Grid.Column="2" Text="0" FontSize="13" FontWeight="Black" Foreground="#2563EB" TextAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txtTeamTotalDeputies" Grid.Column="3" Text="0" FontSize="13" FontWeight="Black" Foreground="#7C3AED" TextAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txtTeamTotalStaff" Grid.Column="4" Text="0" FontSize="13" FontWeight="Black" Foreground="#374151" TextAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txtTeamTotalContract" Grid.Column="5" Text="0" FontSize="13" FontWeight="Black" Foreground="#D97706" TextAlignment="Center" VerticalAlignment="Center"/>
                                            <Border Grid.Column="6" Background="#0F766E" CornerRadius="6" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock x:Name="txtTeamTotalAll" Text="0" FontSize="12.5" FontWeight="Bold" Foreground="White" TextAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </materialDesign:Card>
            </StackPanel>

        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
