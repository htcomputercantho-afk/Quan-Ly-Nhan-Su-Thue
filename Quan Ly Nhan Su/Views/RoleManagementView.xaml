<UserControl x:Class="TaxPersonnelManagement.Views.RoleManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title Header -->
            <RowDefinition Height="Auto"/> <!-- KPI Summary Cards -->
            <RowDefinition Height="*"/>    <!-- Main Card with Toolbar & Table -->
        </Grid.RowDefinitions>

        <!-- Title Header -->
        <StackPanel Orientation="Horizontal" Margin="0 0 0 18">
            <Border Width="44" Height="44" CornerRadius="22" Background="#EFF6FF" Margin="0 0 14 0" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="ShieldAccount" Width="26" Height="26" Foreground="#0052CC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="QUẢN LÝ VAI TRÒ &amp; PHÂN QUYỀN HỆ THỐNG" FontFamily="{StaticResource AppHeadingFont}" FontSize="21" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Thiết lập các vai trò người dùng và phân quyền chi tiết (RBAC) cho từng phân hệ và popup select" FontSize="13" Foreground="#64748B" Margin="0 2 0 0"/>
            </StackPanel>
        </StackPanel>

        <!-- KPI Summary Cards -->
        <Grid Grid.Row="1" Margin="0 0 0 18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Tổng vai trò -->
            <materialDesign:Card Grid.Column="0" UniformCornerRadius="12" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18 14">
                <materialDesign:Card.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#0F172A"/>
                </materialDesign:Card.Effect>
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="TỔNG SỐ VAI TRÒ" FontSize="11.5" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="txtKpiTotalRoles" Text="0" FontSize="26" FontWeight="Bold" Foreground="#0052CC" Margin="0 4 0 0"/>
                        <TextBlock Text="Đang áp dụng trong hệ thống" FontSize="11" Foreground="#94A3B8" Margin="0 2 0 0"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Width="46" Height="46" CornerRadius="23" Background="#EFF6FF" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ShieldLockOutline" Width="24" Height="24" Foreground="#0052CC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </DockPanel>
            </materialDesign:Card>

            <!-- Card 2: Vai trò hệ thống -->
            <materialDesign:Card Grid.Column="2" UniformCornerRadius="12" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18 14">
                <materialDesign:Card.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#0F172A"/>
                </materialDesign:Card.Effect>
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="VAI TRÒ HỆ THỐNG (GỐC)" FontSize="11.5" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="txtKpiSystemRoles" Text="0" FontSize="26" FontWeight="Bold" Foreground="#7C3AED" Margin="0 4 0 0"/>
                        <TextBlock Text="Khóa bảo vệ toàn vẹn" FontSize="11" Foreground="#94A3B8" Margin="0 2 0 0"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Width="46" Height="46" CornerRadius="23" Background="#F5F3FF" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ShieldCrownOutline" Width="24" Height="24" Foreground="#7C3AED" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </DockPanel>
            </materialDesign:Card>

            <!-- Card 3: Tài khoản đã phân quyền -->
            <materialDesign:Card Grid.Column="4" UniformCornerRadius="12" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18 14">
                <materialDesign:Card.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#0F172A"/>
                </materialDesign:Card.Effect>
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="TÀI KHOẢN ĐÃ PHÂN VAI TRÒ" FontSize="11.5" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="txtKpiAssignedUsers" Text="0" FontSize="26" FontWeight="Bold" Foreground="#059669" Margin="0 4 0 0"/>
                        <TextBlock Text="Người dùng được phân quyền" FontSize="11" Foreground="#94A3B8" Margin="0 2 0 0"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Width="46" Height="46" CornerRadius="23" Background="#ECFDF5" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="AccountMultipleCheckOutline" Width="24" Height="24" Foreground="#059669" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </DockPanel>
            </materialDesign:Card>
        </Grid>

        <!-- Main Card with Toolbar & Table -->
        <materialDesign:Card Grid.Row="2" UniformCornerRadius="14" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
            <materialDesign:Card.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.08" Color="#0F172A"/>
            </materialDesign:Card.Effect>

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Toolbar -->
                    <RowDefinition Height="*"/>    <!-- DataGrid -->
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Grid Grid.Row="0" Margin="0 0 0 16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="280" MaxWidth="420"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <Grid Grid.Column="0">
                        <TextBox x:Name="txtSearch" 
                                 materialDesign:HintAssist.Hint="Tìm kiếm vai trò, mô tả..."
                                 Padding="34 9 10 9" TextChanged="TxtSearch_TextChanged"
                                 BorderBrush="#CBD5E1" BorderThickness="1"
                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                 VerticalAlignment="Center" FontSize="13.5">
                        </TextBox>
                        <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" 
                                                 Foreground="#94A3B8" 
                                                 VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10 0 0 0" IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Add Role Button -->
                    <Button Grid.Column="2" 
                            Background="#0052CC"
                            BorderBrush="#0052CC"
                            Foreground="White"
                            ToolTip="Thêm vai trò phân quyền mới"
                            Height="40"
                            Padding="20 0"
                            Click="BtnAddRole_Click"
                            materialDesign:ButtonAssist.CornerRadius="20"
                            Cursor="Hand"
                            FontWeight="Bold">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.22" Color="#0052CC"/>
                        </Button.Effect>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" Margin="0 0 6 0"/>
                            <TextBlock Text="Thêm vai trò mới" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- DataGrid Roles -->
                <DataGrid x:Name="dgRoles" Grid.Row="1"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          BorderThickness="1"
                          BorderBrush="#E2E8F0"
                          Background="White"
                          RowHeight="52"
                          FontSize="13.5"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeadersPresenter">
                            <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                        </Style>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="FontFamily" Value="{StaticResource AppHeadingFont}"/>
                            <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Padding" Value="12 8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="BorderThickness" Value="0 0 1 0"/>
                            <Setter Property="BorderBrush" Value="#1565C0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              RecognizesAccessKey="True"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="Transparent" SnapsToDevicePixels="True">
                                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderThickness" Value="0 0 0 1"/>
                            <Setter Property="BorderBrush" Value="#F1F5F9"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EFF6FF"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="CenterAlignedCell" TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                        <Style x:Key="LeftAlignedCell" TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="14 0"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- STT -->
                        <DataGridTextColumn Binding="{Binding STT}" Header="STT" Width="60" ElementStyle="{StaticResource CenterAlignedCell}"/>

                        <!-- Tên vai trò -->
                        <DataGridTemplateColumn Header="TÊN VAI TRÒ" Width="240">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14 0">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#EFF6FF" Margin="0 0 10 0" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="ShieldCheck" Width="16" Height="16" Foreground="#0052CC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center" Foreground="#0F172A"/>
                                        <Border Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="6" Padding="6 2" Margin="8 0 0 0" VerticalAlignment="Center"
                                                Visibility="{Binding IsSystemBadgeVisibility}">
                                            <TextBlock Text="HỆ THỐNG" FontSize="10" FontWeight="Bold" Foreground="#6D28D9"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Mô tả -->
                        <DataGridTextColumn Binding="{Binding Description}" Header="MÔ TẢ VAI TRÒ" Width="2*" MinWidth="200" ElementStyle="{StaticResource LeftAlignedCell}"/>

                        <!-- Số người dùng -->
                        <DataGridTemplateColumn Header="TÀI KHOẢN GÁN" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#F1F5F9" CornerRadius="12" Padding="12 4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AccountMultipleOutline" Width="15" Height="15" Foreground="#475569" VerticalAlignment="Center" Margin="0 0 6 0"/>
                                            <TextBlock Text="{Binding UserCountText}" FontWeight="SemiBold" FontSize="12.5" Foreground="#1E293B" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Tóm tắt quyền -->
                        <DataGridTemplateColumn Header="QUYỀN HẠN ĐƯỢC CẤP" Width="210">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding PermissionBadgeBackground}" CornerRadius="12" Padding="12 4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PermissionsSummary}" FontWeight="SemiBold" FontSize="12" Foreground="{Binding PermissionBadgeForeground}" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Ngày tạo -->
                        <DataGridTextColumn Binding="{Binding CreatedAtFormatted}" Header="NGÀY TẠO" Width="110" ElementStyle="{StaticResource CenterAlignedCell}"/>

                        <!-- Thao tác -->
                        <DataGridTemplateColumn Header="THAO TÁC" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Sửa -->
                                        <Button Tag="{Binding Id}" Click="BtnEditRole_Click"
                                                Style="{DynamicResource MaterialDesignToolButton}"
                                                ToolTip="Chỉnh sửa vai trò &amp; phân quyền"
                                                Width="34" Height="34" Padding="0" Margin="0 0 8 0" Cursor="Hand">
                                            <Border Width="30" Height="30" CornerRadius="15" Background="#EFF6FF">
                                                <materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16" Foreground="#0052CC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Button>

                                        <!-- Xóa -->
                                        <Button Tag="{Binding Id}" Click="BtnDeleteRole_Click"
                                                Style="{DynamicResource MaterialDesignToolButton}"
                                                ToolTip="Xóa vai trò"
                                                IsEnabled="{Binding CanDelete}"
                                                Width="34" Height="34" Padding="0" Cursor="Hand">
                                            <Border Width="30" Height="30" CornerRadius="15" Background="{Binding DeleteButtonBackground}">
                                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16" 
                                                                        Foreground="{Binding DeleteIconForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
