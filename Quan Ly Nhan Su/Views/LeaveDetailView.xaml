                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Phép năm nay (n) -->
                        <DataGridTemplateColumn x:Name="colCurrentYear" Header="PHÉP NĂM NAY" Width="150">
