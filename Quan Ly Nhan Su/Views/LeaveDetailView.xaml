                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Bộ phận -->
                        <DataGridTextColumn Header="BỘ PHẬN" Binding="{Binding Department}" Width="*" MinWidth="260">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
