                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Bộ phận -->
                        <DataGridTextColumn Header="BỘ PHẬN" Binding="{Binding Department}" Width="*" MinWidth="260">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="Margin" Value="14,6,14,6"/>
                                    <Setter Property="FontSize" Value="13.5"/>
                                    <Setter Property="Foreground" Value="#374151"/>
                                    <Setter Property="ToolTip" Value="{Binding Department}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Số ngày nghỉ ốm -->
                        <DataGridTemplateColumn Header="SỐ NGÀY NGHỈ ỐM" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#FFEBEE" CornerRadius="12" Padding="14,4" HorizontalAlignment="Center" VerticalAlignment="Center">
