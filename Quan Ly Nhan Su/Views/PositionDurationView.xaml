<UserControl x:Class="TaxPersonnelManagement.Views.PositionDurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:TaxPersonnelManagement.Views"
             xmlns:converters="clr-namespace:TaxPersonnelManagement.Converters"
             xmlns:helpers="clr-namespace:TaxPersonnelManagement.Helpers"
             mc:Ignorable="d" 
             Language="vi-VN"
             d:DesignHeight="600" d:DesignWidth="1200">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ComboBox.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Shadows.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Button.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:Base64ToImageConverter x:Key="Base64ToImageConverter"/>
            <converters:DurationConverter x:Key="DurationConverter"/>
            <converters:DateFormatterConverter x:Key="DateFormatterConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10 5 10 10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="0 0 0 15">
            <materialDesign:PackIcon Kind="Timer" Width="28" Height="28" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0 0 10 0"/>
            <TextBlock Text="THỜI GIAN GIỮ VỊ TRÍ CÔNG TÁC" FontFamily="{StaticResource AppHeadingFont}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Filter Toolbar -->
        <materialDesign:Card Grid.Row="1" Margin="0 0 0 12" Padding="20 14" UniformCornerRadius="12" Background="White" Effect="{DynamicResource MaterialDesignShadowDepth1}">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Search Box -->
                <StackPanel Margin="0 0 16 0">
                    <TextBlock Text="Tìm kiếm" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="8 0 0 4"/>
                    <Border Background="White" CornerRadius="20" BorderBrush="#CBD5E1" BorderThickness="1.5" Width="240" Height="40">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Foreground="#64748B" Width="18" Height="18" VerticalAlignment="Center" Margin="12 0 4 0"/>
                            <TextBox x:Name="txtSearch" Grid.Column="1"
                                     materialDesign:HintAssist.Hint="Tên cán bộ hoặc bộ phận..."
                                     materialDesign:HintAssist.Foreground="#94A3B8"
                                     materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                     materialDesign:TextFieldAssist.HasClearButton="True"
                                     BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" Padding="8 0 12 0"
                                     FontSize="13.5" Foreground="#1E293B"
                                     TextChanged="txtSearch_TextChanged"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Calculation Date -->
                <StackPanel Margin="0 0 16 0">
                    <TextBlock Text="Thời điểm tính" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="8 0 0 4"/>
                    <DatePicker x:Name="dpCalculationDate" Width="160" HorizontalContentAlignment="Center"
                                Style="{StaticResource FilterPillDatePicker}"
                                SelectedDateChanged="dpCalculationDate_SelectedDateChanged"/>
                </StackPanel>

                <!-- Thâm niên giữ vị trí (Lọc cột "Năm giữ vị trí công tác") -->
                <StackPanel Margin="0 0 16 0">
                    <TextBlock Text="Thâm niên giữ vị trí" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="8 0 0 4"/>
                    <Border Background="White" CornerRadius="20" BorderBrush="#CBD5E1" BorderThickness="1.5" Height="40" Padding="14 0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="FilterVariant" Width="16" Height="16" Foreground="#64748B" VerticalAlignment="Center" Margin="0 0 6 0"/>
                            <TextBlock Text="Từ" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0 0 6 0"/>
                            <Border Background="#F1F5F9" CornerRadius="8" Width="44" Height="28">
                                <TextBox x:Name="txtFromPositionYears"
                                         BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                         FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B"
                                         TextChanged="txtYearsFilter_TextChanged"
                                         PreviewTextInput="NumberOnly_PreviewTextInput"/>
                            </Border>
                            <TextBlock Text="đến dưới" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="8 0"/>
                            <Border Background="#F1F5F9" CornerRadius="8" Width="44" Height="28">
                                <TextBox x:Name="txtToPositionYears"
                                         BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                         FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B"
                                         TextChanged="txtYearsFilter_TextChanged"
                                         PreviewTextInput="NumberOnly_PreviewTextInput"/>
                            </Border>
                            <TextBlock Text="năm" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="6 0 0 0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Thời gian công tác trong ngành (Lọc cột "Tổng thời gian công tác trong ngành thuế") -->
                <StackPanel Margin="0 0 20 0">
                    <TextBlock Text="Thời gian công tác trong ngành" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="8 0 0 4"/>
                    <Border Background="White" CornerRadius="20" BorderBrush="#CBD5E1" BorderThickness="1.5" Height="40" Padding="14 0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="FilterVariant" Width="16" Height="16" Foreground="#64748B" VerticalAlignment="Center" Margin="0 0 6 0"/>
                            <TextBlock Text="Từ" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0 0 6 0"/>
                            <Border Background="#F1F5F9" CornerRadius="8" Width="44" Height="28">
                                <TextBox x:Name="txtFromTaxYears"
                                         BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                         FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B"
                                         TextChanged="txtYearsFilter_TextChanged"
                                         PreviewTextInput="NumberOnly_PreviewTextInput"/>
                            </Border>
                            <TextBlock Text="đến dưới" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="8 0"/>
                            <Border Background="#F1F5F9" CornerRadius="8" Width="44" Height="28">
                                <TextBox x:Name="txtToTaxYears"
                                         BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                         FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B"
                                         TextChanged="txtYearsFilter_TextChanged"
                                         PreviewTextInput="NumberOnly_PreviewTextInput"/>
                            </Border>
                            <TextBlock Text="năm" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="6 0 0 0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Export Button -->
                <StackPanel VerticalAlignment="Bottom" Margin="0 0 0 0">
                    <Button x:Name="btnExport" Click="btnExport_Click"
                            Style="{DynamicResource MaterialDesignRaisedButton}"
                            Background="#15803D" BorderBrush="#15803D" Foreground="White"
                            materialDesign:ButtonAssist.CornerRadius="20"
                            Height="40" Padding="18 0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExcel" Width="18" Height="18" Margin="0 0 8 0" VerticalAlignment="Center"/>
                            <TextBlock Text="Xuất Excel" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </WrapPanel>
        </materialDesign:Card>

        <!-- Data Grid Card -->
        <materialDesign:Card Grid.Row="2" Style="{StaticResource TableCardStyle}">
            <Grid helpers:ClipHelper.CornerRadius="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="dgPositionDuration" Grid.Row="0"
                          AutoGenerateColumns="False" IsReadOnly="True" 
                          CanUserAddRows="False" HeadersVisibility="Column"
                          LoadingRow="dg_LoadingRow"
                          BorderThickness="0"
                          VerticalGridLinesBrush="Transparent"
                          HorizontalGridLinesBrush="#EEEEEE"
                          GridLinesVisibility="Horizontal" 
                          AlternationCount="0" AlternatingRowBackground="{x:Null}"
                          MinRowHeight="56" VerticalContentAlignment="Center"
                          SelectionMode="Single"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          FrozenColumnCount="2">
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1F2937"/>
                        <Style TargetType="DataGridColumnHeadersPresenter">
                            <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                        </Style>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="FontFamily" Value="{StaticResource AppHeadingFont}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                            <Setter Property="Padding" Value="4 10"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="#1565C0" BorderThickness="0 0 1 0" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              RecognizesAccessKey="True"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="13.5"/>
                            <Setter Property="Padding" Value="4"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                                        <Border Background="Transparent" SnapsToDevicePixels="True">
                                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#1F2937"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#263238"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="BorderThickness" Value="0 0 0 1"/>
                            <Setter Property="BorderBrush" Value="#F1F5F9"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F9FF"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E3F2FD"/>
                                    <Setter Property="Foreground" Value="#1F2937"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="CenterAlignedColumn" TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="FontSize" Value="13.5"/>
                            <Setter Property="Foreground" Value="#374151"/>
                        </Style>
                        <Style x:Key="LeftAlignedColumn" TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Margin" Value="10 0"/>
                            <Setter Property="FontSize" Value="13.5"/>
                            <Setter Property="Foreground" Value="#374151"/>
                        </Style>
                        <Style x:Key="WrappedHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="FontFamily" Value="{StaticResource AppHeadingFont}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="MinHeight" Value="60"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Padding="2" FontFamily="{StaticResource AppHeadingFont}" FontWeight="Bold" Foreground="White"/>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="STT" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center" 
                                               FontWeight="SemiBold" FontSize="14" Foreground="#546E7A"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="HỌ VÀ TÊN" Width="2*" MinWidth="220" HeaderStyle="{StaticResource WrappedHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10 4 0 4">
                                        <Grid Width="32" Height="32" Margin="0 0 10 0" VerticalAlignment="Top">
                                            <Ellipse Fill="{DynamicResource PrimaryHueMidBrush}"/>
                                            <materialDesign:PackIcon Kind="Account" Width="20" Height="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Ellipse>
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding AvatarBase64, Converter={StaticResource Base64ToImageConverter}}" Stretch="UniformToFill"/>
                                                </Ellipse.Fill>
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AvatarBase64}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding AvatarBase64}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>
                                        <TextBlock Text="{Binding FullName}" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="14" Foreground="#263238"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="BỘ PHẬN" Width="2.5*" MinWidth="220" HeaderStyle="{StaticResource WrappedHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="brdDept" Background="#E3F2FD" CornerRadius="5" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,4">
                                        <TextBlock Text="{Binding Department}" FontSize="13" FontWeight="SemiBold" Foreground="#1565C0" TextWrapping="Wrap"/>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Department}" Value="{x:Null}">
                                            <Setter TargetName="brdDept" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Department}" Value="">
                                            <Setter TargetName="brdDept" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="THỜI GIAN CÔNG TÁC&#x0a;THEO QĐ GẦN NHẤT" Width="1.5*" MinWidth="160" HeaderStyle="{StaticResource WrappedHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="brdDecisionDate" Background="#F5F5F5" CornerRadius="6" Padding="6,4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4">
                                        <TextBlock Text="{Binding PositionDecisionDate, Converter={StaticResource DateFormatterConverter}}" FontSize="13.5" Foreground="#616161"/>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding PositionDecisionDate}" Value="{x:Null}">
                                            <Setter TargetName="brdDecisionDate" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="NĂM GIỮ VỊ TRÍ&#x0a;CÔNG TÁC" Width="1.5*" MinWidth="170" HeaderStyle="{StaticResource WrappedHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="brdDuration" Background="#E1F5FE" CornerRadius="6" Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4">
                                        <TextBlock FontWeight="Bold" Foreground="#0288D1" FontSize="13.5">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource DurationConverter}">
                                                    <Binding Path="PositionDecisionDate"/>
                                                    <Binding ElementName="dpCalculationDate" Path="SelectedDate"/>
                                                    <Binding Path="DisplayPositionCalculationDate"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding PositionDecisionDate}" Value="{x:Null}">
                                            <Setter TargetName="brdDuration" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="TỔNG THỜI GIAN CÔNG TÁC&#x0a;TRONG NGÀNH THUẾ" Width="1.8*" MinWidth="170" HeaderStyle="{StaticResource WrappedHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="brdTaxDuration" Background="#E8F5E9" CornerRadius="6" Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4">
                                        <TextBlock FontWeight="Bold" Foreground="#2E7D32" FontSize="13.5">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource DurationConverter}">
                                                    <Binding Path="TaxAuthorityStartDate"/>
                                                    <Binding ElementName="dpCalculationDate" Path="SelectedDate"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding TaxAuthorityStartDate}" Value="{x:Null}">
                                            <Setter TargetName="brdTaxDuration" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="THỜI GIAN CÒN LẠI&#x0a;ĐẾN KHI NGHỈ HƯU" Width="1.8*" MinWidth="170" HeaderStyle="{StaticResource WrappedHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="brdRetireDuration" Background="#FFEBEE" CornerRadius="6" Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4">
                                        <TextBlock FontWeight="Bold" Foreground="#C62828" FontSize="13.5">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource DurationConverter}">
                                                    <Binding ElementName="dpCalculationDate" Path="SelectedDate"/>
                                                    <Binding Path="RetirementDate"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RetirementDate}" Value="{x:Null}">
                                            <Setter TargetName="brdRetireDuration" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="THAO TÁC" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding Id}"
                                            Click="btnPositionActionMenu_Click"
                                            Style="{DynamicResource MaterialDesignIconForegroundButton}"
                                            ToolTip="Thao tác" Width="34" Height="34"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="DotsVertical" Width="20" Height="20" Foreground="#607D8B"/>
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          Click="btnViewDetail_Click">
                                                    <MenuItem.Icon>
                                                        <materialDesign:PackIcon Kind="Eye" Foreground="#0288D1" Width="16" Height="16"/>
                                                    </MenuItem.Icon>
                                                    <MenuItem.Header>
                                                        <TextBlock Text="Xem chi tiết" FontSize="13"/>
                                                    </MenuItem.Header>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Pagination Footer -->
                <Grid Grid.Row="1" Margin="15 8">
                    <TextBlock x:Name="txtPagingInfo" Text="Hiển thị 0 nhân sự" VerticalAlignment="Center" Foreground="#78909C" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnPrevPage" Click="BtnPrevPage_Click"
                                Style="{DynamicResource MaterialDesignIconForegroundButton}" Width="30" Height="30" Margin="0 0 5 0">
                            <materialDesign:PackIcon Kind="ChevronLeft" Foreground="#607D8B"/>
                        </Button>
                        <TextBlock x:Name="txtPageInfo" Text="1 / 1" VerticalAlignment="Center" Margin="10 0" FontWeight="Bold" Foreground="#455A64"/>
                        <Button x:Name="btnNextPage" Click="BtnNextPage_Click"
                                Style="{DynamicResource MaterialDesignIconForegroundButton}" Width="30" Height="30">
                            <materialDesign:PackIcon Kind="ChevronRight" Foreground="#607D8B"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
