<Window x:Class="TaxPersonnelManagement.Views.WarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                    <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" From="0.92" To="1.0" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" From="0.92" To="1.0" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    
    <Border Background="White" CornerRadius="22" Margin="18"
            BorderBrush="#E2E8F0" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="6" Opacity="0.18" Color="#0F172A"/>
        </Border.Effect>

        <Grid>
            <!-- Close Button (✕) -->
            <Button Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0 14 14 0" Width="32" Height="32" Padding="0"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    materialDesign:ButtonAssist.CornerRadius="16"
                    ToolTip="Đóng (Esc)">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="16">
                                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Main Content Container -->
            <StackPanel Margin="32 30 32 26" HorizontalAlignment="Stretch">
                <!-- Dual-Layer Circular Icon Badge -->
                <Border x:Name="borderIconOuter" Width="70" Height="70" CornerRadius="35" 
                        Background="#FFFBEB" HorizontalAlignment="Center" Margin="0 0 0 16">
                    <Border x:Name="borderIconInner" Width="50" Height="50" CornerRadius="25"
                            Background="#FEF3C7" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon x:Name="iconType" Kind="AlertCircleOutline" 
                                                 Width="28" Height="28" Foreground="#D97706" 
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Border>
                
                <!-- Title -->
                <TextBlock x:Name="txtTitle" Text="Thông Báo" 
                           FontFamily="{StaticResource AppHeadingFont}"
                           FontSize="18" FontWeight="Bold" 
                           Foreground="#0F172A" 
                           HorizontalAlignment="Stretch" TextAlignment="Center" 
                           TextWrapping="Wrap" LineHeight="24"
                           Margin="0 0 0 10"/>

                <!-- Message -->
                <TextBlock x:Name="txtMessage" Text="Nội dung thông báo..." 
                           FontFamily="{StaticResource AppRegularFont}"
                           FontSize="13.5" Foreground="#475569" 
                           TextWrapping="Wrap" TextAlignment="Center" 
                           HorizontalAlignment="Stretch" LineHeight="22" 
                           Margin="0 0 0 24"/>

                <!-- Action Button -->
                <Button x:Name="btnConfirm" Content="ĐÃ HIỂU" Click="Close_Click" 
                        FontFamily="{StaticResource AppHeadingFont}"
                        MinWidth="140" Height="42" Padding="24 0"
                        materialDesign:ButtonAssist.CornerRadius="21"
                        Background="#D97706" BorderBrush="#D97706" Foreground="White"
                        FontSize="13" FontWeight="Bold" Cursor="Hand"
                        IsDefault="True" IsCancel="True"
                        HorizontalAlignment="Center"
                        Style="{DynamicResource MaterialDesignRaisedButton}">
                    <Button.Effect>
                        <DropShadowEffect x:Name="btnShadow" BlurRadius="12" ShadowDepth="3" Opacity="0.25" Color="#D97706"/>
                    </Button.Effect>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
