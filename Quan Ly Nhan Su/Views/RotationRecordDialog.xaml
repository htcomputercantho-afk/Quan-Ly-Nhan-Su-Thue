<Window x:Class="TaxPersonnelManagement.Views.RotationRecordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:TaxPersonnelManagement.Converters"
        xmlns:helpers="clr-namespace:TaxPersonnelManagement.Helpers"
        Language="vi-VN"
        Title="Thông tin Luân chuyển / Điều động"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="780" MaxHeight="780" SizeToContent="Height"
        FontFamily="{DynamicResource MaterialDesignFont}"
        FontSize="13.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Button.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ComboBox.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.TextBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Modern DatePicker Style (Đồng bộ với PlanningRecordDialog) -->
            <Style x:Key="ModernDatePicker" TargetType="DatePicker">
                <Setter Property="Language" Value="vi-VN"/>
                <Setter Property="helpers:DatePickerHelper.FixCalendarLocale" Value="True"/>
                <Setter Property="helpers:DatePickerHelper.EnableSmartDateEntry" Value="True"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Padding" Value="10 0"/>
                <Setter Property="Foreground" Value="#1E293B"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DatePicker">
                            <Border x:Name="border" Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>

                                    <DatePickerTextBox x:Name="PART_TextBox" 
                                                       Grid.Column="0"
                                                       HorizontalContentAlignment="Stretch"
                                                       VerticalContentAlignment="Center"
                                                       Background="Transparent" 
                                                       BorderThickness="0"
                                                       Padding="{TemplateBinding Padding}"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       FontWeight="{TemplateBinding FontWeight}"
                                                       FontSize="{TemplateBinding FontSize}"
                                                       Focusable="True">
                                        <DatePickerTextBox.Template>
                                            <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                                                <Grid>
                                                    <ScrollViewer x:Name="PART_ContentHost" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                    <TextBlock x:Name="Watermark" Text="dd/MM/yyyy" 
                                                               IsHitTestVisible="False" 
                                                               Foreground="#94A3B8"
                                                               VerticalAlignment="Center" 
                                                               Margin="10 0 0 0"
                                                               FontSize="13.5"
                                                               Visibility="Hidden"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </DatePickerTextBox.Template>
                                    </DatePickerTextBox>

                                    <Button x:Name="PART_Button" 
                                            Grid.Column="1" 
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            Margin="0 0 4 0"
                                            Background="Transparent" 
                                            BorderThickness="0"
                                            Foreground="#1565C0"
                                            Style="{DynamicResource MaterialDesignToolButton}">
                                        <materialDesign:PackIcon Kind="CalendarMonth" Width="18" Height="18"/>
                                    </Button>

                                    <Popup x:Name="PART_Popup" 
                                           AllowsTransparency="True" 
                                           Placement="Bottom" 
                                           StaysOpen="False"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#1565C0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern Form TextBox (Watermark ẩn khi gõ, không dùng floating hint đè tiêu đề) -->
            <Style x:Key="ModernFormTextBox" TargetType="TextBox">
                <Setter Property="Height" Value="40"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="10 0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="Foreground" Value="#1E293B"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <Grid>
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="false" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                    <TextBlock x:Name="Watermark" Text="{Binding Path=(materialDesign:HintAssist.Hint), RelativeSource={RelativeSource TemplatedParent}}"
                                               Foreground="#94A3B8" Margin="11 0 0 0" IsHitTestVisible="False"
                                               VerticalAlignment="Center" Visibility="Collapsed" FontSize="{TemplateBinding FontSize}"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#1565C0"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#1565C0"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern Form MultiLine TextBox -->
            <Style x:Key="ModernFormMultiLineTextBox" TargetType="TextBox">
                <Setter Property="Padding" Value="10 8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="Foreground" Value="#1E293B"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <Grid>
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="false" VerticalAlignment="Stretch" Margin="{TemplateBinding Padding}"/>
                                    <TextBlock x:Name="Watermark" Text="{Binding Path=(materialDesign:HintAssist.Hint), RelativeSource={RelativeSource TemplatedParent}}"
                                               Foreground="#94A3B8" Margin="11 8 0 0" IsHitTestVisible="False"
                                               VerticalAlignment="Top" Visibility="Collapsed" FontSize="{TemplateBinding FontSize}"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#1565C0"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#1565C0"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern Form ComboBox (Viền chuẩn kín 100%, có TextTrimming, không lỗi nút vuông xanh) -->
            <Style x:Key="ModernFormComboBox" TargetType="ComboBox">
                <Setter Property="Height" Value="40"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#1E293B"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="12 0 32 0"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Padding" Value="12 9"/>
                            <Setter Property="FontSize" Value="13.5"/>
                            <Setter Property="Foreground" Value="#1E293B"/>
                            <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid SnapsToDevicePixels="True">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6"
                                        ToolTip="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Grid>
                                        <ContentPresenter x:Name="ContentSite"
                                                          IsHitTestVisible="False"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                          Margin="{TemplateBinding Padding}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                                            <ContentPresenter.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                </Style>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>

                                        <ToggleButton x:Name="toggleButton"
                                                      Focusable="False"
                                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                      ClickMode="Press"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"
                                                      Style="{x:Null}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent">
                                                        <materialDesign:PackIcon Kind="ChevronDown"
                                                                                 Width="18" Height="18"
                                                                                 Foreground="#64748B"
                                                                                 HorizontalAlignment="Right"
                                                                                 VerticalAlignment="Center"
                                                                                 Margin="0 0 10 0"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>

                                        <Popup x:Name="Popup"
                                               Placement="Bottom"
                                               IsOpen="{TemplateBinding IsDropDownOpen}"
                                               AllowsTransparency="True"
                                               Focusable="False"
                                               PopupAnimation="Slide">
                                            <Grid x:Name="DropDown"
                                                  SnapsToDevicePixels="True"
                                                  MinWidth="{TemplateBinding ActualWidth}"
                                                  MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                  Margin="0 4 0 0">
                                                <Border x:Name="DropDownBorder"
                                                        Background="White"
                                                        BorderBrush="#CBD5E1"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.12" Color="#000000"/>
                                                    </Border.Effect>
                                                    <ScrollViewer Margin="2 4" CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                                    </ScrollViewer>
                                                </Border>
                                            </Grid>
                                        </Popup>
                                    </Grid>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#1565C0"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#1565C0"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#1565C0"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="12" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="#000000" RenderingBias="Quality"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/> <!-- Header -->
                <RowDefinition Height="*"/>   <!-- Content -->
                <RowDefinition Height="58"/>  <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header (Đồng bộ chuẩn phong cách xanh #1565C0 bên Tổng quan) -->
            <Border Grid.Row="0" Background="#1565C0" CornerRadius="11 11 0 0" Padding="18 0" MouseLeftButtonDown="Header_MouseDown" Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="SwapHorizontalBold" Foreground="White" Width="22" Height="22" Margin="0 0 10 0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtTitle" Text="THÔNG TIN ĐIỀU ĐỘNG / LUÂN CHUYỂN" FontFamily="{StaticResource AppHeadingFont}" Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="1" Click="BtnCancel_Click" Cursor="Hand"
                            Style="{DynamicResource MaterialDesignToolButton}"
                            Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0">
                        <materialDesign:PackIcon Kind="Close" Foreground="White" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Form content -->
            <ScrollViewer Grid.Row="1" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24 16 24 14">

                    <!-- PHẦN 1: CHỌN CÁN BỘ CÔNG CHỨC -->
                    <StackPanel Margin="0 0 0 14">
                        <TextBlock Text="Cán bộ công chức (*)" FontWeight="SemiBold" Foreground="#334155" Margin="0 0 0 6" FontSize="13.5"/>

                        <!-- State 1: Chưa chọn cán bộ -->
                        <Border x:Name="pnlPersonnelEmpty" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14 12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="40" Height="40" CornerRadius="20" Background="#E2E8F0" VerticalAlignment="Center" Margin="0 0 12 0">
                                        <materialDesign:PackIcon Kind="AccountSearchOutline" Width="22" Height="22" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Chưa chọn cán bộ công chức" FontWeight="SemiBold" FontSize="13.5" Foreground="#334155"/>
                                        <TextBlock Text="Bấm nút bên phải để tìm kiếm và chọn cán bộ từ danh sách hồ sơ" FontSize="12" Foreground="#64748B" Margin="0 2 0 0"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="1" Click="BtnSelectPersonnel_Click"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="#1565C0" Foreground="White" Height="36" Padding="14 0"
                                        materialDesign:ButtonAssist.CornerRadius="6" Cursor="Hand" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AccountSearch" Width="17" Height="17" Foreground="White" Margin="0 0 6 0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Chọn cán bộ..." FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- State 2: Đã chọn cán bộ -->
                        <Border x:Name="pnlPersonnelSelected" Visibility="Collapsed" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="14 12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Avatar -->
                                    <Grid Width="44" Height="44" Margin="0 0 12 0" VerticalAlignment="Center">
                                        <Border CornerRadius="22" Background="#1565C0">
                                            <TextBlock x:Name="txtPersonnelAvatar" Text="NV" FontWeight="Bold" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="imgPersonnelAvatar" CornerRadius="22" Visibility="Collapsed"/>
                                    </Grid>

                                    <!-- Thông tin chi tiết cán bộ -->
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="txtPersonnelFullName" Text="Họ và tên cán bộ" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>

                                        <StackPanel Orientation="Horizontal" Margin="0 4 0 0">
                                            <!-- CCCD -->
                                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="7 2" Margin="0 0 8 0">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="CardAccountDetailsOutline" Width="13" Height="13" Foreground="#64748B" Margin="0 0 4 0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="txtPersonnelCCCD" Text="CCCD: ---" FontSize="12" Foreground="#334155" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Ngày sinh -->
                                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="7 2" Margin="0 0 8 0">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="CalendarMonthOutline" Width="13" Height="13" Foreground="#64748B" Margin="0 0 4 0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="txtPersonnelDOB" Text="--/--/----" FontSize="12" Foreground="#334155" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Bộ phận hiện tại -->
                                            <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="4" Padding="7 2">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="OfficeBuildingOutline" Width="13" Height="13" Foreground="#0284C7" Margin="0 0 4 0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="txtPersonnelDept" Text="Bộ phận" FontSize="12" FontWeight="SemiBold" Foreground="#0369A1" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Nút Đổi cán bộ -->
                                <Button x:Name="btnChangePersonnel" Grid.Column="1" Click="BtnSelectPersonnel_Click"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        BorderBrush="#1565C0" Foreground="#1565C0" Height="34" Padding="12 0"
                                        materialDesign:ButtonAssist.CornerRadius="6" Cursor="Hand" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AccountSwitchOutline" Width="15" Height="15" Foreground="#1565C0" Margin="0 0 5 0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Đổi cán bộ" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- PHẦN 2: PHÂN LOẠI KẾ HOẠCH & NĂM -->
                    <Grid Margin="0 0 0 14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <!-- Loại hình -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Loại hình (*)" FontWeight="SemiBold" Foreground="#334155" Margin="0 0 0 6" FontSize="13"/>
                            <ComboBox x:Name="cmbRotationType" Style="{StaticResource ModernFormComboBox}">
                                <ComboBoxItem Content="Điều động" IsSelected="True"/>
                                <ComboBoxItem Content="Luân chuyển"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Kế hoạch thực hiện -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Kế hoạch thực hiện (*)" FontWeight="SemiBold" Foreground="#334155" Margin="0 0 0 6" FontSize="13"/>
                            <ComboBox x:Name="cmbPlanType" Style="{StaticResource ModernFormComboBox}">
                                <ComboBoxItem Content="Trong kế hoạch" IsSelected="True"/>
                                <ComboBoxItem Content="Ngoài kế hoạch"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Năm kế hoạch -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Năm (*)" FontWeight="SemiBold" Foreground="#334155" Margin="0 0 0 6" FontSize="13"/>
                            <ComboBox x:Name="cmbPlanYear" Style="{StaticResource ModernFormComboBox}">
                                <ComboBoxItem Content="2028"/>
                                <ComboBoxItem Content="2027"/>
                                <ComboBoxItem Content="2026" IsSelected="True"/>
                                <ComboBoxItem Content="2025"/>
                                <ComboBoxItem Content="2024"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- PHẦN 3: BỘ PHẬN TỪ -> ĐẾN (Đồng bộ thống nhất, viền kín, ToolTip rõ ràng) -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14 12" Margin="0 0 0 14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Bộ phận đang công tác -->
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0 0 0 6">
                                    <materialDesign:PackIcon Kind="HomeExportOutline" Width="15" Height="15" Foreground="#64748B" Margin="0 0 5 0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Bộ phận hiện tại (Đang công tác)" FontWeight="SemiBold" FontSize="13" Foreground="#334155"/>
                                </StackPanel>
                                <ComboBox x:Name="cmbFromDepartment"
                                          Style="{StaticResource ModernFormComboBox}"
                                          ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}"/>
                            </StackPanel>

                            <!-- Arrow Indicator -->
                            <Border Grid.Column="1" Width="30" Height="30" CornerRadius="15" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0 20 0 0">
                                <materialDesign:PackIcon Kind="ArrowRightBold" Width="16" Height="16" Foreground="#1565C0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Bộ phận dự kiến điều động đến -->
                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal" Margin="0 0 0 6">
                                    <materialDesign:PackIcon Kind="HomeImportOutline" Width="15" Height="15" Foreground="#1565C0" Margin="0 0 5 0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Bộ phận dự kiến điều động đến" FontWeight="SemiBold" FontSize="13" Foreground="#1565C0"/>
                                </StackPanel>
                                <ComboBox x:Name="cmbToDepartment"
                                          Style="{StaticResource ModernFormComboBox}"
                                          ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Self}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- PHẦN 4: TRẠNG THÁI THỰC HIỆN & QUYẾT ĐỊNH (Không bị đè chữ) -->
                    <Border x:Name="pnlCompletionCard" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14 12" Margin="0 0 0 14">
                        <StackPanel>
                            <!-- CheckBox đã gom toàn bộ tiêu đề & chú thích vào Content, không lo đè chữ -->
                            <CheckBox x:Name="chkIsCompleted"
                                      Checked="ChkIsCompleted_Changed" Unchecked="ChkIsCompleted_Changed"
                                      VerticalAlignment="Center">
                                <CheckBox.Content>
                                    <StackPanel Margin="6 0 0 0">
                                        <TextBlock Text="Đã thực hiện điều động / luân chuyển" FontWeight="Bold" FontSize="13.5" Foreground="#1E293B"/>
                                        <TextBlock Text="Tích chọn nếu đã ban hành quyết định chính thức để quản lý số QĐ và ngày hiệu lực."
                                                   FontSize="12" Foreground="#64748B" Margin="0 3 0 0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox.Content>
                            </CheckBox>

                            <!-- Khối thông tin quyết định (Chỉ hiển thị khi đã thực hiện) -->
                            <StackPanel x:Name="pnlDecision" Margin="0 12 0 0" Visibility="Collapsed">
                                <Border Background="White" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="14 12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                                            <materialDesign:PackIcon Kind="FileDocumentCheckOutline" Width="17" Height="17" Foreground="#16A34A" VerticalAlignment="Center" Margin="0 0 6 0"/>
                                            <TextBlock Text="Thông tin Quyết định &amp; Ngày hiệu lực" FontWeight="Bold" FontSize="13" Foreground="#166534" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Hàng 1: Số QĐ & Ngày ra QĐ -->
                                        <Grid Margin="0 0 0 10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Số QĐ -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Số quyết định (*)" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0 0 0 6"/>
                                                <TextBox x:Name="txtDecisionNumber"
                                                         Style="{StaticResource ModernFormTextBox}"
                                                         materialDesign:HintAssist.Hint="VD: 123/QĐ-CCT"/>
                                            </StackPanel>

                                            <!-- Ngày ra QĐ -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Ngày ra quyết định" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0 0 0 6"/>
                                                <DatePicker x:Name="dpDecisionDate"
                                                            Style="{StaticResource ModernDatePicker}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Hàng 2: Ngày hiệu lực -->
                                        <StackPanel>
                                            <TextBlock Text="Ngày hiệu lực (bắt đầu công tác tại bộ phận mới)" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0 0 0 6"/>
                                            <DatePicker x:Name="dpEffectiveDate"
                                                        Style="{StaticResource ModernDatePicker}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- PHẦN 5: GHI CHÚ -->
                    <StackPanel Margin="0 0 0 4">
                        <TextBlock Text="Ghi chú thêm" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0 0 0 6"/>
                        <TextBox x:Name="txtNote"
                                 Style="{StaticResource ModernFormMultiLineTextBox}"
                                 materialDesign:HintAssist.Hint="Ghi chú thêm thông tin hoặc lưu ý nếu có..."
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="60" MaxHeight="90"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer buttons (Đồng bộ chuẩn gọn gàng) -->
            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0 1 0 0" Padding="18 10" CornerRadius="0 0 11 11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Nút Xóa (chỉ hiện khi edit) -->
                    <Button x:Name="btnDelete" Grid.Column="0"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="#DC2626" BorderBrush="#FECACA" Background="#FEF2F2"
                            Padding="14 0" Height="38"
                            materialDesign:ButtonAssist.CornerRadius="6"
                            Visibility="Collapsed" Cursor="Hand"
                            Click="BtnDelete_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16" Foreground="#DC2626" Margin="0 0 6 0" VerticalAlignment="Center"/>
                            <TextBlock Text="Xóa bản ghi" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnCancel" Grid.Column="2" Content="Hủy bỏ"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            BorderBrush="#CBD5E1" Foreground="#475569" Background="#F1F5F9"
                            Padding="20 0" Height="38" FontSize="13"
                            materialDesign:ButtonAssist.CornerRadius="6" Cursor="Hand"
                            Click="BtnCancel_Click"/>

                    <!-- Nút Chuyển sang chỉnh sửa (khi ở chế độ xem chi tiết) -->
                    <Button x:Name="btnEditMode" Grid.Column="4"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#1565C0" Foreground="White"
                            Padding="20 0" Height="38" FontSize="13"
                            materialDesign:ButtonAssist.CornerRadius="6" Cursor="Hand"
                            Visibility="Collapsed"
                            Click="BtnEditMode_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18" Foreground="White" Margin="0 0 6 0" VerticalAlignment="Center"/>
                            <TextBlock Text="Chỉnh sửa" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnSave" Grid.Column="4"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#1565C0" Foreground="White"
                            Padding="22 0" Height="38" FontSize="13"
                            materialDesign:ButtonAssist.CornerRadius="6" Cursor="Hand"
                            Click="BtnSave_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Check" Width="18" Height="18" Foreground="White" Margin="0 0 6 0" VerticalAlignment="Center"/>
                            <TextBlock Text="Lưu thông tin" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
