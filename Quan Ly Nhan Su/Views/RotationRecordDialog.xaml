<Window x:Class="TaxPersonnelManagement.Views.RotationRecordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:TaxPersonnelManagement.Converters"
        xmlns:helpers="clr-namespace:TaxPersonnelManagement.Helpers"
        Language="vi-VN"
        Title="Luân chuyển / Điều động"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="730" MaxHeight="750" SizeToContent="Height"
        FontFamily="{DynamicResource MaterialDesignFont}"
        FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Button.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ComboBox.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.TextBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="16" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.16" Color="#000000" RenderingBias="Quality"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" CornerRadius="15 15 0 0" Padding="20 14" MouseLeftButtonDown="Header_MouseDown" Cursor="SizeAll">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#005A9E" Offset="0"/>
                        <GradientStop Color="#0078D4" Offset="0.5"/>
                        <GradientStop Color="#0284C7" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Glassmorphic Icon Badge -->
                        <Border Width="42" Height="42" CornerRadius="10" Background="#26FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" Margin="0 0 14 0" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="SwapHorizontalBold" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="txtTitle" Text="Thêm mới Luân chuyển / Điều động"
                                       FontSize="17" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="txtSubtitle" Text="Điền đầy đủ thông tin bên dưới"
                                       FontSize="12.5" Foreground="#E0F2FE" Margin="0 3 0 0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="1" Click="BtnCancel_Click" Cursor="Hand"
                            Style="{DynamicResource MaterialDesignToolButton}"
                            Width="32" Height="32" Padding="0" Background="#22FFFFFF" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="16"/>
                            </Style>
                        </Button.Resources>
                        <materialDesign:PackIcon Kind="Close" Foreground="White" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Form content -->
            <ScrollViewer Grid.Row="1" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28 18 28 18">

                    <!-- Phần 1: Chọn cán bộ -->
                    <StackPanel Margin="0 0 0 16">
                        <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
                            <Border CornerRadius="6" Background="#EFF6FF" Padding="8 4" Margin="0 0 6 0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountTie" Width="15" Height="15" Foreground="#0078D4" VerticalAlignment="Center" Margin="0 0 6 0"/>
                                    <TextBlock Text="THÔNG TIN CÁN BỘ" FontSize="12" FontWeight="Bold" Foreground="#0078D4" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="*" Foreground="#EF4444" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- State 1: Chưa chọn cán bộ -->
                        <Border x:Name="pnlPersonnelEmpty" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="10" Padding="16 14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="44" Height="44" CornerRadius="22" Background="#E2E8F0" VerticalAlignment="Center" Margin="0 0 14 0">
                                        <materialDesign:PackIcon Kind="AccountSearchOutline" Width="24" Height="24" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Chưa chọn cán bộ công chức" FontWeight="SemiBold" FontSize="14" Foreground="#334155"/>
                                        <TextBlock Text="Bấm nút bên phải để tìm kiếm và chọn cán bộ từ danh sách hồ sơ" FontSize="12" Foreground="#64748B" Margin="0 2 0 0"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="1" Click="BtnSelectPersonnel_Click"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="#0078D4" Foreground="White" Height="40" Padding="16 0"
                                        materialDesign:ButtonAssist.CornerRadius="8" Cursor="Hand" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AccountSearch" Width="18" Height="18" Foreground="White" Margin="0 0 6 0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Chọn cán bộ" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- State 2: Đã chọn cán bộ -->
                        <Border x:Name="pnlPersonnelSelected" Visibility="Collapsed" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1.5" CornerRadius="10" Padding="16 14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Avatar (Ảnh đại diện hoặc Initials) -->
                                    <Grid Width="48" Height="48" Margin="0 0 14 0" VerticalAlignment="Center">
                                        <Border CornerRadius="24">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#0078D4" Offset="0"/>
                                                    <GradientStop Color="#0284C7" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock x:Name="txtPersonnelAvatar" Text="NV" FontWeight="Bold" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="imgPersonnelAvatar" CornerRadius="24" Visibility="Collapsed"/>
                                    </Grid>

                                    <!-- Information Details -->
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="txtPersonnelFullName" Text="Họ và tên cán bộ" FontWeight="Bold" FontSize="16" Foreground="#0F172A"/>

                                        <StackPanel Orientation="Horizontal" Margin="0 6 0 0">
                                            <!-- CCCD Pill -->
                                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8 3" Margin="0 0 8 0">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="CardAccountDetailsOutline" Width="14" Height="14" Foreground="#64748B" Margin="0 0 5 0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="txtPersonnelCCCD" Text="CCCD: ---" FontSize="12" Foreground="#334155" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- DOB Pill -->
                                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8 3" Margin="0 0 8 0">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="CalendarMonthOutline" Width="14" Height="14" Foreground="#64748B" Margin="0 0 5 0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="txtPersonnelDOB" Text="--/--/----" FontSize="12" Foreground="#334155" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Department Pill -->
                                            <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="8 3">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="OfficeBuildingOutline" Width="14" Height="14" Foreground="#0284C7" Margin="0 0 5 0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="txtPersonnelDept" Text="Bộ phận" FontSize="12" FontWeight="SemiBold" Foreground="#0369A1" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Change Personnel Button -->
                                <Button Grid.Column="1" Click="BtnSelectPersonnel_Click"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        BorderBrush="#0284C7" Foreground="#0284C7" Height="36" Padding="12 0"
                                        materialDesign:ButtonAssist.CornerRadius="8" Cursor="Hand" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AccountSwitchOutline" Width="16" Height="16" Foreground="#0284C7" Margin="0 0 6 0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Đổi cán bộ" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Phần 2: Thông tin điều động -->
                    <StackPanel Margin="0 0 0 16">
                        <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                            <Border CornerRadius="6" Background="#EFF6FF" Padding="8 4">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="SwapHorizontalCircleOutline" Width="15" Height="15" Foreground="#0078D4" VerticalAlignment="Center" Margin="0 0 6 0"/>
                                    <TextBlock Text="THÔNG TIN ĐIỀU ĐỘNG / LUÂN CHUYỂN" FontSize="12" FontWeight="Bold" Foreground="#0078D4" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Loại, Kế hoạch và Năm -->
                        <Grid Margin="0 0 0 12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0 0 0 6">
                                    <materialDesign:PackIcon Kind="SwapVertical" Width="15" Height="15" Foreground="#0078D4" Margin="0 0 5 0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Loại hình *" FontWeight="SemiBold" FontSize="13" Foreground="#334155"/>
                                </StackPanel>
                                <ComboBox x:Name="cmbRotationType"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          Padding="12 10" FontSize="14" Height="42"
                                          materialDesign:TextFieldAssist.UnderlineBrush="#0078D4">
                                    <ComboBoxItem Content="Điều động" IsSelected="True"/>
                                    <ComboBoxItem Content="Luân chuyển"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal" Margin="0 0 0 6">
                                    <materialDesign:PackIcon Kind="ClipboardListOutline" Width="15" Height="15" Foreground="#0078D4" Margin="0 0 5 0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Kế hoạch thực hiện *" FontWeight="SemiBold" FontSize="13" Foreground="#334155"/>
                                </StackPanel>
                                <ComboBox x:Name="cmbPlanType"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          Padding="12 10" FontSize="14" Height="42"
                                          materialDesign:TextFieldAssist.UnderlineBrush="#0078D4">
                                    <ComboBoxItem Content="Trong kế hoạch" IsSelected="True"/>
                                    <ComboBoxItem Content="Ngoài kế hoạch"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <StackPanel Orientation="Horizontal" Margin="0 0 0 6">
                                    <materialDesign:PackIcon Kind="CalendarClock" Width="15" Height="15" Foreground="#0078D4" Margin="0 0 5 0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Năm *" FontWeight="SemiBold" FontSize="13" Foreground="#334155"/>
                                </StackPanel>
                                <ComboBox x:Name="cmbPlanYear"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          Padding="12 10 4 10" FontSize="14" Height="42"
                                          materialDesign:TextFieldAssist.UnderlineBrush="#0078D4">
                                    <ComboBoxItem Content="2028"/>
                                    <ComboBoxItem Content="2027"/>
                                    <ComboBoxItem Content="2026" IsSelected="True"/>
                                    <ComboBoxItem Content="2025"/>
                                    <ComboBoxItem Content="2024"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Bộ phận From -> To Transition Flow Card -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14 12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Bộ phận đang công tác -->
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0 0 0 6">
                                        <materialDesign:PackIcon Kind="HomeExportOutline" Width="15" Height="15" Foreground="#64748B" Margin="0 0 5 0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Bộ phận đang công tác" FontWeight="SemiBold" FontSize="12.5" Foreground="#475569"/>
                                    </StackPanel>
                                    <ComboBox x:Name="cmbFromDepartment"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              IsTextSearchEnabled="True" FontSize="13.5"
                                              Padding="10 8" Height="40"
                                              Background="White"/>
                                </StackPanel>

                                <!-- Arrow Indicator -->
                                <Border Grid.Column="1" Width="34" Height="34" CornerRadius="17" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0 18 0 0">
                                    <materialDesign:PackIcon Kind="ArrowRightBold" Width="18" Height="18" Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Bộ phận dự kiến điều động đến -->
                                <StackPanel Grid.Column="2">
                                    <StackPanel Orientation="Horizontal" Margin="0 0 0 6">
                                        <materialDesign:PackIcon Kind="HomeImportOutline" Width="15" Height="15" Foreground="#0078D4" Margin="0 0 5 0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Bộ phận dự kiến điều động đến" FontWeight="SemiBold" FontSize="12.5" Foreground="#0078D4"/>
                                    </StackPanel>
                                    <ComboBox x:Name="cmbToDepartment"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              IsTextSearchEnabled="True" FontSize="13.5"
                                              Padding="10 8" Height="40"
                                              Background="White"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Phần 3: Trạng thái thực hiện & Quyết định -->
                    <Border x:Name="pnlCompletionCard" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16 14" Margin="0 0 0 16">
                        <StackPanel>
                            <!-- CheckBox -->
                            <CheckBox x:Name="chkIsCompleted"
                                      FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"
                                      Checked="ChkIsCompleted_Changed" Unchecked="ChkIsCompleted_Changed">
                                <CheckBox.Content>
                                    <TextBlock Text="Đã thực hiện điều động / luân chuyển" FontWeight="Bold" FontSize="14" Foreground="#1E293B"/>
                                </CheckBox.Content>
                            </CheckBox>
                            <TextBlock Text="Tích chọn mục này nếu đã ban hành quyết định chính thức để quản lý số quyết định và ngày hiệu lực."
                                       FontSize="12" Foreground="#64748B" Margin="30 2 0 0"/>

                            <!-- Thông tin quyết định (hiện khi đã thực hiện) -->
                            <StackPanel x:Name="pnlDecision" Margin="0 14 0 0" Visibility="Collapsed">
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0 0 0 12">
                                            <materialDesign:PackIcon Kind="FileDocumentCheckOutline" Width="18" Height="18" Foreground="#16A34A" VerticalAlignment="Center" Margin="0 0 6 0"/>
                                            <TextBlock Text="Thông tin Quyết định &amp; Ngày hiệu lực" FontWeight="Bold" FontSize="13" Foreground="#166534" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Số QĐ & Ngày ra QĐ -->
                                        <Grid Margin="0 0 0 12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0 0 0 6">
                                                    <materialDesign:PackIcon Kind="FileDocumentOutline" Width="14" Height="14" Foreground="#64748B" Margin="0 0 5 0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Số quyết định *" FontWeight="SemiBold" FontSize="12.5" Foreground="#334155"/>
                                                </StackPanel>
                                                <TextBox x:Name="txtDecisionNumber"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                         materialDesign:HintAssist.Hint="VD: 123/QĐ-CCT"
                                                         Height="40" Padding="10 8"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <StackPanel Orientation="Horizontal" Margin="0 0 0 6">
                                                    <materialDesign:PackIcon Kind="CalendarCheckOutline" Width="14" Height="14" Foreground="#64748B" Margin="0 0 5 0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Ngày ra quyết định" FontWeight="SemiBold" FontSize="12.5" Foreground="#334155"/>
                                                </StackPanel>
                                                <DatePicker x:Name="dpDecisionDate"
                                                            Style="{DynamicResource MaterialDesignOutlinedDatePicker}"
                                                            Height="40" Padding="10 8"
                                                            helpers:DatePickerHelper.FixCalendarLocale="True"
                                                            helpers:DatePickerHelper.EnableSmartDateEntry="True"
                                                            materialDesign:HintAssist.Hint="dd/MM/yyyy"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Ngày hiệu lực -->
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0 0 0 6">
                                                <materialDesign:PackIcon Kind="CalendarClockOutline" Width="14" Height="14" Foreground="#64748B" Margin="0 0 5 0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Ngày hiệu lực (ngày bắt đầu công tác tại bộ phận mới)" FontWeight="SemiBold" FontSize="12.5" Foreground="#334155"/>
                                            </StackPanel>
                                            <DatePicker x:Name="dpEffectiveDate"
                                                        Style="{DynamicResource MaterialDesignOutlinedDatePicker}"
                                                        Height="40" Padding="10 8"
                                                        helpers:DatePickerHelper.FixCalendarLocale="True"
                                                        helpers:DatePickerHelper.EnableSmartDateEntry="True"
                                                        materialDesign:HintAssist.Hint="dd/MM/yyyy"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Phần 4: Ghi chú -->
                    <StackPanel Margin="0 0 0 8">
                        <StackPanel Orientation="Horizontal" Margin="0 0 0 6">
                            <materialDesign:PackIcon Kind="NoteEditOutline" Width="15" Height="15" Foreground="#64748B" Margin="0 0 5 0" VerticalAlignment="Center"/>
                            <TextBlock Text="Ghi chú" FontWeight="SemiBold" FontSize="12.5" Foreground="#334155"/>
                        </StackPanel>
                        <TextBox x:Name="txtNote"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Ghi chú thêm thông tin hoặc lưu ý nếu có..."
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="65" MaxHeight="100" Padding="10 8"
                                 Background="White"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer buttons -->
            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0 1 0 0" Padding="20 12" CornerRadius="0 0 15 15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Nút Xóa (chỉ hiện khi edit) -->
                    <Button x:Name="btnDelete" Grid.Column="0"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="#DC2626" BorderBrush="#FCA5A5"
                            Padding="14 0" Height="38"
                            materialDesign:ButtonAssist.CornerRadius="8"
                            Visibility="Collapsed" Cursor="Hand"
                            Click="BtnDelete_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16" Foreground="#DC2626" Margin="0 0 6 0" VerticalAlignment="Center"/>
                            <TextBlock Text="Xóa bản ghi" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Content="Hủy"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            BorderBrush="#CBD5E1" Foreground="#475569"
                            Padding="22 0" Height="38"
                            materialDesign:ButtonAssist.CornerRadius="8" Cursor="Hand"
                            Click="BtnCancel_Click"/>

                    <Button x:Name="btnSave" Grid.Column="4"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#0078D4" Foreground="White"
                            Padding="22 0" Height="38"
                            materialDesign:ButtonAssist.CornerRadius="8" Cursor="Hand"
                            Click="BtnSave_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Check" Width="18" Height="18" Foreground="White" Margin="0 0 6 0" VerticalAlignment="Center"/>
                            <TextBlock Text="Lưu thông tin" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
