<Window x:Class="TaxPersonnelManagement.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Xác nhận" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{DynamicResource MaterialDesignFont}"
        ShowInTaskbar="False">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                    <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" From="0.9" To="1.0" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" From="0.9" To="1.0" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border Background="White" CornerRadius="20" Margin="20"
            BorderBrush="#F1F5F9" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="6" Opacity="0.18" Color="#0F172A"/>
        </Border.Effect>

        <Grid>
            <!-- Close Button (X) -->
            <Button Click="btnCancel_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0 14 14 0" Width="32" Height="32" Padding="0"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    materialDesign:ButtonAssist.CornerRadius="16"
                    ToolTip="Hủy (Esc)">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="16">
                                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Main Content Container -->
            <StackPanel Margin="32 30 32 26" HorizontalAlignment="Stretch">
                <!-- Dual-Layer Circular Icon Badge -->
                <Border Width="72" Height="72" CornerRadius="36" 
                        Background="#FEF2F2" HorizontalAlignment="Center" Margin="0 0 0 16">
                    <Border Width="52" Height="52" CornerRadius="26"
                            Background="#FEE2E2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon x:Name="iconConfirm" Kind="DeleteAlertOutline" 
                                                 Width="28" Height="28" Foreground="#EF4444" 
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Border>
                
                <!-- Title -->
                <TextBlock x:Name="txtTitle" Text="Xác Nhận Thao Tác" 
                           FontFamily="{StaticResource AppHeadingFont}"
                           FontSize="19" FontWeight="Bold" 
                           Foreground="#1E293B" 
                           HorizontalAlignment="Center" TextAlignment="Center" 
                           Margin="0 0 0 10"/>

                <!-- Message -->
                <TextBlock x:Name="txtMessage" Text="Bạn có chắc chắn muốn thực hiện thao tác này?" 
                           FontFamily="{StaticResource AppRegularFont}"
                           FontSize="14" Foreground="#475569" 
                           TextWrapping="Wrap" TextAlignment="Center" 
                           HorizontalAlignment="Center" LineHeight="22" 
                           Margin="0 0 0 24"/>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="btnCancel" Content="HỦY BỎ" Click="btnCancel_Click" 
                            FontFamily="{StaticResource AppHeadingFont}"
                            Width="120" Height="42" Margin="0 0 12 0"
                            materialDesign:ButtonAssist.CornerRadius="21"
                            Background="White" BorderBrush="#CBD5E1" Foreground="#64748B"
                            FontSize="12.5" FontWeight="Bold" Cursor="Hand"
                            IsCancel="True"/>

                    <Button x:Name="btnConfirm" Content="XÁC NHẬN XÓA" Click="btnConfirm_Click" 
                            FontFamily="{StaticResource AppHeadingFont}"
                            Width="145" Height="42"
                            materialDesign:ButtonAssist.CornerRadius="21"
                            Background="#EF4444" BorderBrush="#EF4444" Foreground="White"
                            FontSize="12.5" FontWeight="Bold" Cursor="Hand"
                            IsDefault="True"
                            Style="{DynamicResource MaterialDesignRaisedButton}">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.28" Color="#EF4444"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
