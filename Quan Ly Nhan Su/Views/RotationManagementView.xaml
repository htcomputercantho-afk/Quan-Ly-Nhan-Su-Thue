                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayBirthDate}" FontSize="13" Foreground="#334155"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 5. GIỚI TÍNH -->
                                    <DataGridTemplateColumn Header="GIỚI TÍNH" Width="85">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding GenderBadgeBg}" BorderBrush="{Binding GenderBadgeBorder}"
                                                        BorderThickness="1" CornerRadius="12" Padding="12 4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding GenderText}" FontSize="12" FontWeight="Bold"
                                                               Foreground="{Binding GenderBadgeFg}" HorizontalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 6. BỘ PHẬN ĐANG CÔNG TÁC -->
                                    <DataGridTemplateColumn Header="BỘ PHẬN ĐANG&#x0a;CÔNG TÁC" Width="2.5*" MinWidth="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayFromDepartment}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#334155" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10 4"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 7. BỘ PHẬN DỰ KIẾN ĐIỀU ĐỘNG -->
                                    <DataGridTemplateColumn Header="BỘ PHẬN DỰ KIẾN&#x0a;ĐIỀU ĐỘNG" Width="2.5*" MinWidth="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayToDepartment}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#1E293B" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10 4"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 7. SĐT -->
                                    <DataGridTemplateColumn Header="SĐT" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayPhone}" FontSize="13" Foreground="#334155"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 8. EMAIL -->
                                    <DataGridTemplateColumn Header="EMAIL" Width="1.8*" MinWidth="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayEmail}" FontSize="12.5" Foreground="#1D4ED8"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="8 4"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 9. ĐÃ LUÂN CHUYỂN / ĐIỀU ĐỘNG -->
                                    <DataGridTemplateColumn Header="ĐÃ LUÂN CHUYỂN&#x0a;/ ĐIỀU ĐỘNG" Width="145">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding StatusBg}" BorderBrush="{Binding StatusBorder}"
                                                        BorderThickness="1" CornerRadius="14" Padding="10 4"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="{Binding StatusIcon}" Width="15" Height="15"
                                                                                 Foreground="{Binding StatusFg}" VerticalAlignment="Center" Margin="0 0 6 0"/>
                                                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{Binding StatusFg}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 10. SỐ QĐ -->
                                    <DataGridTemplateColumn Header="SỐ QĐ" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayDecisionNumber}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="#1E293B" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6 4"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 11. NGÀY RA QĐ -->
                                    <DataGridTemplateColumn Header="NGÀY RA QĐ" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayDecisionDate}" FontSize="13" Foreground="#334155"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 12. THAO TÁC -->
                                    <DataGridTemplateColumn Header="THAO TÁC" Width="95">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button Click="BtnEditRow_Click" ToolTip="Sửa bản ghi"
                                                            Style="{StaticResource MaterialDesignIconButton}" Width="34" Height="34" Padding="0" Foreground="#1976D2">
                                                        <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18"/>
                                                    </Button>
                                                    <Button Click="BtnDeleteRow_Click" ToolTip="Xóa bản ghi"
                                                            Style="{StaticResource MaterialDesignIconButton}" Width="34" Height="34" Padding="0" Foreground="#D32F2F" Margin="6 0 0 0">
                                                        <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </materialDesign:Card>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ============================================================ -->
        <!-- HIỆU ỨNG ĐỢI XUẤT FILE EXCEL / XỬ LÝ (LOADING OVERLAY) -->
        <!-- ============================================================ -->
        <Grid x:Name="loadingOverlay" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="1000">
            <!-- Nền mờ Backdrop -->
            <Border Background="Black" Opacity="0.35"/>

            <!-- Khung thông báo đang xuất file -->
            <Border Background="White" CornerRadius="16" Padding="32 26"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.2" Color="#000000"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="240">
                    <ProgressBar Style="{DynamicResource MaterialDesignCircularProgressBar}"
                                 Value="0" IsIndeterminate="True" 
                                 Width="46" Height="46" 
                                 Foreground="#107C41" HorizontalAlignment="Center" Margin="0 0 0 16"/>
                    <TextBlock Text="Đang xuất dữ liệu ra Excel..." FontSize="15" FontWeight="Bold" 
                               Foreground="#1E293B" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="Vui lòng đợi trong giây lát..." FontSize="12.5" 
                               Foreground="#64748B" HorizontalAlignment="Center" Margin="0 6 0 0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
