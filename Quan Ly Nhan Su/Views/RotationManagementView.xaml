<Page x:Class="TaxPersonnelManagement.Views.RotationManagementView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:converters="clr-namespace:TaxPersonnelManagement.Converters"
      mc:Ignorable="d"
      Language="vi-VN"
      d:DesignHeight="850" d:DesignWidth="1400"
      Title="Luân Chuyển, Điều Động"
      Background="#F8FAFC"
      FontFamily="{DynamicResource MaterialDesignFont}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Shadows.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ComboBox.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:DateFormatterConverter x:Key="DateFormatterConverter"/>
            <converters:EmptyStringToDashConverter x:Key="EmptyStringToDashConverter"/>
            <converters:Base64ToImageConverter x:Key="Base64ToImageConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Modern Segmented Tab Control -->
            <Style x:Key="ModernTabControl" TargetType="TabControl">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- Tab Header Pill Container -->
                                <Border Grid.Row="0" Background="#E2E8F0" CornerRadius="10" Padding="4"
                                        HorizontalAlignment="Left" Margin="0 0 0 14">
                                    <StackPanel IsItemsHost="True" Orientation="Horizontal"/>
                                </Border>
                                <!-- Content Host -->
                                <Border Grid.Row="1" Background="Transparent">
                                    <ContentPresenter ContentSource="SelectedContent"/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern Tab Item -->
            <Style x:Key="ModernTabItem" TargetType="TabItem">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="tabBorder" Background="Transparent" CornerRadius="8" Padding="18 9" Margin="2 0">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="tabBorder" Property="Background" Value="White"/>
                                    <Setter TargetName="tabBorder" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#64748B" BlurRadius="6" ShadowDepth="1" Opacity="0.15" Direction="270"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsSelected" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="tabBorder" Property="Background" Value="#CBD5E1"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Custom ColumnHeaderStyle with Royal Blue Background -->
            <Style x:Key="RoyalBlueHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="MinHeight" Value="52"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridColumnHeader">
                            <Grid SnapsToDevicePixels="True">
                                <Border Background="#1976D2"
                                        BorderBrush="#1565C0" BorderThickness="0,0,1,0"
                                        Padding="6 4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ContentPresenter.ContentTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                           TextTrimming="None"
                                                           TextAlignment="Center" LineHeight="17"
                                                           FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </ContentPresenter.ContentTemplate>
                                    </ContentPresenter>
                                </Border>
                                <Thumb x:Name="PART_RightHeaderGripper"
                                       HorizontalAlignment="Right"
                                       Width="6"
                                       Cursor="SizeWE">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- DataGrid Column Headers Presenter Background -->
            <Style TargetType="{x:Type DataGridColumnHeadersPresenter}">
                <Setter Property="Background" Value="#1976D2"/>
            </Style>

            <!-- Custom DataGrid Row Style -->
            <Style x:Key="ModernRowStyle" TargetType="DataGridRow">
                <Setter Property="MinHeight" Value="52"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F1F5F9"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#E0F2FE"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Custom Cell Style -->
            <Style x:Key="ModernCellStyle" TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Custom Filter ComboBox Style matching user screenshot -->
            <Style x:Key="CustomFilterComboBox" TargetType="ComboBox">
                <Setter Property="Height" Value="36"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#1E293B"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="10 0 26 0"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid SnapsToDevicePixels="True">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6"
                                        ToolTip="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Grid>
                                        <ContentPresenter x:Name="ContentSite"
                                                          IsHitTestVisible="False"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                          Margin="{TemplateBinding Padding}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                                            <ContentPresenter.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                </Style>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>

                                        <ToggleButton x:Name="toggleButton"
                                                      Focusable="False"
                                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                      ClickMode="Press"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"
                                                      Style="{x:Null}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent">
                                                        <materialDesign:PackIcon Kind="ChevronDown"
                                                                                 Width="18" Height="18"
                                                                                 Foreground="#1976D2"
                                                                                 HorizontalAlignment="Right"
                                                                                 VerticalAlignment="Center"
                                                                                 Margin="0 0 8 0"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>

                                        <Popup x:Name="Popup"
                                               Placement="Bottom"
                                               IsOpen="{TemplateBinding IsDropDownOpen}"
                                               AllowsTransparency="True"
                                               Focusable="False"
                                               PopupAnimation="Slide">
                                            <Grid x:Name="DropDown"
                                                  SnapsToDevicePixels="True"
                                                  MinWidth="{TemplateBinding ActualWidth}"
                                                  MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                  Margin="0 4 0 0">
                                                <Border x:Name="DropDownBorder"
                                                        Background="White"
                                                        BorderBrush="#CBD5E1"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="2" Opacity="0.12" Color="#000000"/>
                                                    </Border.Effect>
                                                    <ScrollViewer Margin="2 4" CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                                    </ScrollViewer>
                                                </Border>
                                            </Grid>
                                        </Popup>
                                    </Grid>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#1976D2"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#1976D2"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="OverridesDefaultStyle" Value="True"/>
                            <Setter Property="Height" Value="34"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Foreground" Value="#1E293B"/>
                            <Setter Property="Padding" Value="10 0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="Transparent"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}"
                                                Margin="4 1">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF"/>
                                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Hero Header Bar -->
            <RowDefinition Height="Auto"/> <!-- Row 1: 5 KPI Summary Cards -->
            <RowDefinition Height="*"/>    <!-- Row 2: Tab Content & Workspace -->
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- ROW 0: HERO HEADER BAR -->
        <!-- ============================================================ -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20 16" Margin="0 0 0 16"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#64748B" BlurRadius="12" ShadowDepth="2" Opacity="0.06" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title with icon -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EFF6FF" CornerRadius="12" Width="48" Height="48" Margin="0 0 16 0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="SwapHorizontalBold" Width="26" Height="26"
                                                 Foreground="#1976D2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LUÂN CHUYỂN, ĐIỀU ĐỘNG CÔNG CHỨC" FontSize="20" FontWeight="Bold"
                                   Foreground="#0F172A"/>
                        <TextBlock x:Name="txtTotalCount" Text="Theo dõi và quản lý kế hoạch điều động, luân chuyển cán bộ công chức thuế"
                                   FontSize="12.5" Foreground="#64748B" Margin="0 4 0 0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            BorderBrush="#CBD5E1" Foreground="#475569" Height="38" Padding="14 0"
                            materialDesign:ButtonAssist.CornerRadius="6"
                            Click="BtnRefresh_Click" VerticalAlignment="Center" Cursor="Hand"
                            ToolTip="Tải lại toàn bộ dữ liệu từ CSDL">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" VerticalAlignment="Center" Margin="0 0 6 0"/>
                            <TextBlock Text="Làm mới" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- ROW 1: 5 KPI SUMMARY CARDS -->
        <!-- ============================================================ -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="0 0 0 16">
            <!-- Card 1: Tổng số lượt -->
            <materialDesign:Card x:Name="cardTotal" Height="92" Margin="0 0 5 0" UniformCornerRadius="12"
                                 materialDesign:ElevationAssist.Elevation="Dp2" Cursor="Hand"
                                 MouseLeftButtonUp="CardTotal_Click" ToolTip="Nhấp để hiển thị tất cả bản ghi">
                <Grid SnapsToDevicePixels="True">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0078D4" Offset="0.0"/>
                            <GradientStop Color="#00B7C3" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <materialDesign:PackIcon Kind="AccountSwitch" Width="72" Height="72"
                                             Foreground="White" Opacity="0.12"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Margin="0 0 -8 -10"/>
                    <Grid VerticalAlignment="Center" Margin="16 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AccountSwitch" Width="15" Height="15" Foreground="White" VerticalAlignment="Center" Margin="0 0 6 0"/>
                            <TextBlock Text="TỔNG SỐ" FontSize="11.5" FontWeight="SemiBold" Foreground="White" Opacity="0.95" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" x:Name="txtTotalKPICount" Text="0" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0 6 0 0" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </materialDesign:Card>

            <!-- Card 2: Trong kế hoạch -->
            <materialDesign:Card x:Name="cardInPlan" Height="92" Margin="3 0 3 0" UniformCornerRadius="12"
                                 materialDesign:ElevationAssist.Elevation="Dp2" Cursor="Hand"
                                 MouseLeftButtonUp="CardInPlan_Click" ToolTip="Nhấp để chuyển sang tab Trong kế hoạch">
                <Grid SnapsToDevicePixels="True">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#5B21B6" Offset="0.0"/>
                            <GradientStop Color="#7C3AED" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <materialDesign:PackIcon Kind="ClipboardCheckOutline" Width="72" Height="72"
                                             Foreground="White" Opacity="0.12"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Margin="0 0 -8 -10"/>
                    <Grid VerticalAlignment="Center" Margin="16 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ClipboardCheckOutline" Width="15" Height="15" Foreground="White" VerticalAlignment="Center" Margin="0 0 6 0"/>
                            <TextBlock Text="TRONG KẾ HOẠCH" FontSize="11.5" FontWeight="SemiBold" Foreground="White" Opacity="0.95" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" x:Name="txtInPlanKPICount" Text="0" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0 6 0 0" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </materialDesign:Card>

            <!-- Card 3: Ngoài kế hoạch -->
            <materialDesign:Card x:Name="cardOutPlan" Height="92" Margin="3 0 3 0" UniformCornerRadius="12"
                                 materialDesign:ElevationAssist.Elevation="Dp2" Cursor="Hand"
                                 MouseLeftButtonUp="CardOutPlan_Click" ToolTip="Nhấp để chuyển sang tab Ngoài kế hoạch">
                <Grid SnapsToDevicePixels="True">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#D97706" Offset="0.0"/>
                            <GradientStop Color="#F59E0B" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="72" Height="72"
                                             Foreground="White" Opacity="0.12"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Margin="0 0 -8 -10"/>
                    <Grid VerticalAlignment="Center" Margin="16 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="15" Height="15" Foreground="White" VerticalAlignment="Center" Margin="0 0 6 0"/>
                            <TextBlock Text="NGOÀI KẾ HOẠCH" FontSize="11.5" FontWeight="SemiBold" Foreground="White" Opacity="0.95" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" x:Name="txtOutPlanKPICount" Text="0" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0 6 0 0" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </materialDesign:Card>

            <!-- Card 4: Đã thực hiện -->
            <materialDesign:Card x:Name="cardCompleted" Height="92" Margin="3 0 3 0" UniformCornerRadius="12"
                                 materialDesign:ElevationAssist.Elevation="Dp2" Cursor="Hand"
                                 MouseLeftButtonUp="CardCompleted_Click" ToolTip="Nhấp để lọc danh sách đã thực hiện">
                <Grid SnapsToDevicePixels="True">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2E7D32" Offset="0.0"/>
                            <GradientStop Color="#4CAF50" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <materialDesign:PackIcon Kind="CheckDecagram" Width="72" Height="72"
                                             Foreground="White" Opacity="0.12"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Margin="0 0 -8 -10"/>
                    <Grid VerticalAlignment="Center" Margin="16 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CheckDecagram" Width="15" Height="15" Foreground="White" VerticalAlignment="Center" Margin="0 0 6 0"/>
                            <TextBlock Text="ĐÃ THỰC HIỆN" FontSize="11.5" FontWeight="SemiBold" Foreground="White" Opacity="0.95" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" x:Name="txtCompletedKPICount" Text="0" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0 6 0 0" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </materialDesign:Card>

            <!-- Card 5: Chưa thực hiện -->
            <materialDesign:Card x:Name="cardPending" Height="92" Margin="5 0 0 0" UniformCornerRadius="12"
                                 materialDesign:ElevationAssist.Elevation="Dp2" Cursor="Hand"
                                 MouseLeftButtonUp="CardPending_Click" ToolTip="Nhấp để lọc danh sách chưa thực hiện">
                <Grid SnapsToDevicePixels="True">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#C62828" Offset="0.0"/>
                            <GradientStop Color="#EF5350" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <materialDesign:PackIcon Kind="ClockTimeFourOutline" Width="72" Height="72"
                                             Foreground="White" Opacity="0.12"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Margin="0 0 -8 -10"/>
                    <Grid VerticalAlignment="Center" Margin="16 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ClockTimeFourOutline" Width="15" Height="15" Foreground="White" VerticalAlignment="Center" Margin="0 0 6 0"/>
                            <TextBlock Text="CHƯA THỰC HIỆN" FontSize="11.5" FontWeight="SemiBold" Foreground="White" Opacity="0.95" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" x:Name="txtPendingKPICount" Text="0" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0 6 0 0" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </materialDesign:Card>
        </UniformGrid>

        <!-- ============================================================ -->
        <!-- ROW 2: MAIN WORKSPACE CARD & TABS -->
        <!-- ============================================================ -->
        <Grid Grid.Row="2">
            <TabControl x:Name="tabMain" Style="{StaticResource ModernTabControl}" Padding="0" Background="Transparent">

                <!-- ==================== TAB 1: TRONG KẾ HOẠCH ==================== -->
                <TabItem x:Name="tabInPlan" Style="{StaticResource ModernTabItem}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ClipboardCheckOutline" Width="18" Height="18"
                                                     Foreground="#1976D2" VerticalAlignment="Center" Margin="0 0 8 0"/>
                            <TextBlock Text="Trong Kế Hoạch" FontSize="14" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10"
                                    Padding="8 2" Margin="8 0 0 0" VerticalAlignment="Center">
                                <TextBlock x:Name="badgeInPlan" Text="0" FontSize="11.5" FontWeight="Bold" Foreground="#1976D2"/>
                            </Border>
                        </StackPanel>
                    </TabItem.Header>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Filter Bar -->
                            <RowDefinition Height="*"/>    <!-- DataGrid -->
                        </Grid.RowDefinitions>

                        <!-- Filter Toolbar matching user screenshot -->
                        <materialDesign:Card Grid.Row="0" UniformCornerRadius="8" Background="White"
                                             materialDesign:ElevationAssist.Elevation="Dp1"
                                             Padding="12 8" Margin="0 0 0 12">
