<Window x:Class="TaxPersonnelManagement.Views.PersonnelDegreesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Danh sách văn bằng, chứng chỉ" Height="730" Width="1160" MinWidth="1050" MinHeight="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Language="vi-VN"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Tab RadioButton Style dạng Pill/Chip đẹp mắt -->
            <Style x:Key="SegmentedTabRadioButton" TargetType="RadioButton">
                <Setter Property="Background" Value="#F1F5F9"/>
                <Setter Property="Foreground" Value="#475569"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="16 8"/>
                <Setter Property="Margin" Value="0 0 8 0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="border" Background="{TemplateBinding Background}" 
                                    CornerRadius="6" BorderThickness="1" BorderBrush="#E2E8F0" 
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#1D4ED8"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Style cho từng Item trong Dropdown ComboBox (Pill bo góc, hiệu ứng hover nhẹ nhàng) -->
            <Style TargetType="ComboBoxItem">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="12 8"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="#1E293B"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="ItemBorder" 
                                    Background="Transparent" 
                                    CornerRadius="6" 
                                    Margin="2 1" 
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter VerticalAlignment="Center" 
                                                  HorizontalAlignment="Left"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF"/>
                                    <Setter Property="Foreground" Value="#2563EB"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#DBEAFE"/>
                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="True"/>
                                        <Condition Property="IsHighlighted" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#BFDBFE"/>
                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern Select ComboBox (Dành cho cboDegreeType) -->
            <Style x:Key="ModernSelectComboBox" TargetType="ComboBox">
                <Setter Property="Height" Value="36"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#0F172A"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Padding" Value="12 0 0 0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="MaxDropDownHeight" Value="260"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="border" Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        CornerRadius="7" SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                          Margin="{TemplateBinding Padding}"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left"/>
                                        
                                        <materialDesign:PackIcon x:Name="chevronIcon" Kind="ChevronDown" Width="18" Height="18" 
                                                                 Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                                 Grid.Column="1" IsHitTestVisible="False"/>
                                        
                                        <ToggleButton x:Name="toggleButton" Grid.ColumnSpan="2" Focusable="False"
                                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                      ClickMode="Press" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent"/>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                    </Grid>
                                </Border>
                                
                                <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" 
                                       Focusable="False" PopupAnimation="Fade" HorizontalOffset="-4" VerticalOffset="4">
                                    <Grid x:Name="DropDown" SnapsToDevicePixels="True" 
                                          MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" 
                                          MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="4,0,4,8">
                                        <Border x:Name="DropDownBorder" Background="White" BorderThickness="1" BorderBrush="#E2E8F0" 
                                                CornerRadius="8" Padding="4">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="12" Direction="-90" ShadowDepth="3" Opacity="0.12"/>
                                            </Border.Effect>
                                            <ScrollViewer MaxHeight="220" SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                    <Setter TargetName="chevronIcon" Property="Foreground" Value="#2563EB"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                                    <Setter TargetName="chevronIcon" Property="Foreground" Value="#2563EB"/>
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                    <Setter TargetName="chevronIcon" Property="Foreground" Value="#2563EB"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern Editable ComboBox (Dành cho cboDegreeName có autocomplete/nhập liệu) -->
            <Style x:Key="ModernEditableComboBox" TargetType="ComboBox">
                <Setter Property="Height" Value="36"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#0F172A"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="12 0 4 0"/>
                <Setter Property="MaxDropDownHeight" Value="260"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="border" Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        CornerRadius="7" SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- TextBox nhập liệu được WPF ComboBox nhận diện -->
                                        <TextBox x:Name="PART_EditableTextBox"
                                                 Grid.Column="0"
                                                 Style="{x:Null}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="{TemplateBinding Padding}"
                                                 VerticalContentAlignment="Center"
                                                 HorizontalAlignment="Stretch"
                                                 FontSize="{TemplateBinding FontSize}"
                                                 FontFamily="{TemplateBinding FontFamily}"
                                                 Foreground="{TemplateBinding Foreground}"
                                                 IsReadOnly="{TemplateBinding IsReadOnly}"
                                                 FocusVisualStyle="{x:Null}"
                                                 Focusable="True"/>

                                        <!-- Watermark / Chữ mờ gợi ý khi chưa có text -->
                                        <TextBlock x:Name="PART_Placeholder" Grid.Column="0" Text="Nhập hoặc chọn tên văn bằng..." 
                                                   Foreground="#94A3B8" IsHitTestVisible="False" Margin="13 0 0 0" 
                                                   VerticalAlignment="Center" FontSize="13" Visibility="Collapsed"/>
                                        
                                        <!-- Nút mở dropdown với icon chevron -->
                                        <ToggleButton x:Name="toggleButton" Grid.Column="1" Focusable="False"
                                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                      ClickMode="Press" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent" Padding="0">
                                                        <materialDesign:PackIcon x:Name="chevronIcon" Kind="ChevronDown" Width="18" Height="18" 
                                                                                 Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="chevronIcon" Property="Foreground" Value="#2563EB"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                    </Grid>
                                </Border>
                                
                                <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" 
                                       Focusable="False" PopupAnimation="Fade" HorizontalOffset="-4" VerticalOffset="4">
                                    <Grid x:Name="DropDown" SnapsToDevicePixels="True" 
                                          MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" 
                                          MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="4,0,4,8">
                                        <Border x:Name="DropDownBorder" Background="White" BorderThickness="1" BorderBrush="#E2E8F0" 
                                                CornerRadius="8" Padding="4">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="12" Direction="-90" ShadowDepth="3" Opacity="0.12"/>
                                            </Border.Effect>
                                            <ScrollViewer MaxHeight="220" SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="PART_Placeholder" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern TextBox dành cho các ô nhập liệu còn lại trong Dialog -->
            <Style x:Key="ModernDialogTextBox" TargetType="TextBox">
                <Setter Property="Height" Value="36"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="12 0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="#0F172A"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="border" Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="7" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" 
                                              HorizontalScrollBarVisibility="Hidden" 
                                              VerticalScrollBarVisibility="Hidden"
                                              VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="12" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Direction="-90" RenderingBias="Quality" ShadowDepth="4" Opacity="0.25"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>  <!-- 0: Header -->
                <RowDefinition Height="Auto"/> <!-- 1: Personnel Info Banner -->
                <RowDefinition Height="Auto"/> <!-- 2: Category Filter Tabs -->
                <RowDefinition Height="Auto"/> <!-- 3: Add / Edit Form -->
                <RowDefinition Height="*"/>    <!-- 4: Degrees DataGrid -->
                <RowDefinition Height="55"/>   <!-- 5: Footer -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header -->
            <Border Grid.Row="0" Background="#1E293B" CornerRadius="12 12 0 0" Padding="20 0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CertificateOutline" Foreground="#38BDF8" Width="24" Height="24" Margin="0 0 10 0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtDialogTitle" Text="DANH SÁCH VĂN BẰNG &amp; CHỨNG CHỈ CỦA CÁN BỘ" Foreground="White" FontSize="15.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Click="btnClose_Click" Background="Transparent" BorderThickness="0" Padding="0" Width="32" Height="32" Cursor="Hand" ToolTip="Đóng">
                        <materialDesign:PackIcon Kind="Close" Foreground="#94A3B8" Width="22" Height="22"/>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Row 1: Personnel Info Banner -->
            <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Profile Chips -->
                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <!-- Cán bộ -->
                        <Border Background="White" CornerRadius="8" Padding="12 6" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0 0 10 4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="AccountTie" Width="18" Height="18" Foreground="#2563EB" VerticalAlignment="Center" Margin="0 0 6 0"/>
                                <TextBlock Text="Cán bộ: " FontWeight="Medium" Foreground="#64748B" FontSize="13"/>
                                <TextBlock x:Name="txtPersonnelName" Text="Nguyễn Văn A" FontWeight="Bold" Foreground="#0F172A" FontSize="13.5"/>
                            </StackPanel>
                        </Border>

                        <!-- Phòng ban -->
                        <Border Background="White" CornerRadius="8" Padding="12 6" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0 0 10 4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="OfficeBuilding" Width="18" Height="18" Foreground="#0284C7" VerticalAlignment="Center" Margin="0 0 6 0"/>
                                <TextBlock Text="Phòng ban: " FontWeight="Medium" Foreground="#64748B" FontSize="13"/>
                                <TextBlock x:Name="txtPersonnelDept" Text="---" FontWeight="SemiBold" Foreground="#1E293B" FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <!-- Chức vụ -->
                        <Border Background="White" CornerRadius="8" Padding="12 6" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0 0 10 4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="BriefcaseOutline" Width="18" Height="18" Foreground="#0D9488" VerticalAlignment="Center" Margin="0 0 6 0"/>
                                <TextBlock Text="Chức vụ: " FontWeight="Medium" Foreground="#64748B" FontSize="13"/>
                                <TextBlock x:Name="txtPersonnelPosition" Text="---" FontWeight="SemiBold" Foreground="#1E293B" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- Hint note -->
                    <Border Grid.Column="1" Background="#FEF3C7" CornerRadius="8" Padding="12 6" BorderBrush="#FDE68A" BorderThickness="1" VerticalAlignment="Center" Margin="0 0 0 4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="StarCheck" Width="16" Height="16" Foreground="#D97706" VerticalAlignment="Center" Margin="0 0 6 0"/>
                            <TextBlock Text="Bằng có dấu ⭐ sẽ được hiển thị ra ngoài hồ sơ cán bộ" FontSize="12" Foreground="#92400E" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Row 2: Category Filter Tabs -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,10">
                <WrapPanel VerticalAlignment="Center">
                    <RadioButton x:Name="rbTabAll" Content="📑 Tất cả văn bằng" GroupName="DegreeTypeTabs" 
                                 Style="{StaticResource SegmentedTabRadioButton}" 
                                 Checked="TabFilter_Checked" IsChecked="True"/>
                    <RadioButton x:Name="rbTabMajor" Content="🎓 Trình độ chuyên môn" GroupName="DegreeTypeTabs" 
                                 Style="{StaticResource SegmentedTabRadioButton}" 
                                 Checked="TabFilter_Checked"/>
                    <RadioButton x:Name="rbTabIT" Content="💻 Tin học" GroupName="DegreeTypeTabs" 
                                 Style="{StaticResource SegmentedTabRadioButton}" 
                                 Checked="TabFilter_Checked"/>
                    <RadioButton x:Name="rbTabLang" Content="🌐 Ngoại ngữ" GroupName="DegreeTypeTabs" 
                                 Style="{StaticResource SegmentedTabRadioButton}" 
                                 Checked="TabFilter_Checked"/>
                    <RadioButton x:Name="rbTabState" Content="🏛️ QL Nhà nước" GroupName="DegreeTypeTabs" 
                                 Style="{StaticResource SegmentedTabRadioButton}" 
                                 Checked="TabFilter_Checked"/>
                    <RadioButton x:Name="rbTabPolTheory" Content="📕 Lý luận chính trị" GroupName="DegreeTypeTabs" 
                                 Style="{StaticResource SegmentedTabRadioButton}" 
                                 Checked="TabFilter_Checked"/>
                    <RadioButton x:Name="rbTabOther" Content="📜 Chứng chỉ khác" GroupName="DegreeTypeTabs" 
                                 Style="{StaticResource SegmentedTabRadioButton}" 
                                 Checked="TabFilter_Checked"/>
                </WrapPanel>
            </Border>

            <!-- Row 3: Add / Edit Form -->
            <Border Grid.Row="3" Margin="20,12,20,8" Padding="18,14" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Direction="-90" ShadowDepth="2" Opacity="0.06"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Form Header -->
                    <Grid Grid.Row="0" Margin="0 0 0 12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon x:Name="iconFormMode" Kind="PlusCircleOutline" Width="19" Height="19" Foreground="#2563EB" VerticalAlignment="Center" Margin="0 0 6 0"/>
                            <TextBlock x:Name="txtFormModeTitle" Text="Thêm văn bằng, chứng chỉ mới" FontWeight="Bold" FontSize="13.5" Foreground="#2563EB" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="btnCancelEdit" Click="btnCancelEdit_Click" 
                                Background="#FEE2E2" BorderThickness="1" BorderBrush="#FECACA" Cursor="Hand"
                                Height="28" Padding="10 0" HorizontalAlignment="Right" Foreground="#DC2626" Visibility="Collapsed"
                                materialDesign:ButtonAssist.CornerRadius="6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Margin="0 0 4 0" VerticalAlignment="Center"/>
                                <TextBlock Text="Hủy sửa" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Form Fields -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Line 1: Loại bằng, Tên bằng, Chuyên ngành, Nơi cấp -->
                        <Grid Grid.Row="0" Margin="0 0 0 10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Loại bằng -->
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0 0 0 5">
                                    <materialDesign:PackIcon Kind="TagOutline" Width="14" Height="14" Foreground="#475569" VerticalAlignment="Center" Margin="0 0 4 0"/>
                                    <TextBlock Text="Loại bằng *" FontSize="12" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ComboBox x:Name="cboDegreeType" SelectionChanged="cboDegreeType_SelectionChanged" Style="{StaticResource ModernSelectComboBox}">
                                    <ComboBoxItem Content="Chuyên môn" IsSelected="True"/>
                                    <ComboBoxItem Content="Tin học"/>
                                    <ComboBoxItem Content="Ngoại ngữ"/>
                                    <ComboBoxItem Content="Quản lý Nhà nước"/>
                                    <ComboBoxItem Content="Lý luận chính trị"/>
                                    <ComboBoxItem Content="Chứng chỉ khác"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Tên bằng / chứng chỉ -->
                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal" Margin="0 0 0 5">
                                    <materialDesign:PackIcon Kind="CertificateOutline" Width="14" Height="14" Foreground="#475569" VerticalAlignment="Center" Margin="0 0 4 0"/>
                                    <TextBlock Text="Tên bằng / Chứng chỉ *" FontSize="12" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ComboBox x:Name="cboDegreeName" IsEditable="True" Style="{StaticResource ModernEditableComboBox}"/>
                            </StackPanel>

                            <!-- Chuyên ngành -->
                            <StackPanel Grid.Column="4">
                                <StackPanel Orientation="Horizontal" Margin="0 0 0 5">
                                    <materialDesign:PackIcon Kind="SchoolOutline" Width="14" Height="14" Foreground="#475569" VerticalAlignment="Center" Margin="0 0 4 0"/>
                                    <TextBlock Text="Chuyên ngành / Lĩnh vực" FontSize="12" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBox x:Name="txtDegreeMajor" Style="{StaticResource ModernDialogTextBox}"/>
                            </StackPanel>

                            <!-- Cơ sở đào tạo / Nơi cấp -->
                            <StackPanel Grid.Column="6">
                                <StackPanel Orientation="Horizontal" Margin="0 0 0 5">
                                    <materialDesign:PackIcon Kind="TownHall" Width="14" Height="14" Foreground="#475569" VerticalAlignment="Center" Margin="0 0 4 0"/>
                                    <TextBlock Text="Cơ sở đào tạo / Nơi cấp" FontSize="12" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBox x:Name="txtInstitution" Style="{StaticResource ModernDialogTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Line 2: Xếp loại, Năm/Ngày cấp, Checkbox Bằng chính, Nút Lưu -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Xếp loại / Điểm số -->
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0 0 0 5">
                                    <materialDesign:PackIcon Kind="MedalOutline" Width="14" Height="14" Foreground="#475569" VerticalAlignment="Center" Margin="0 0 4 0"/>
                                    <TextBlock Text="Xếp loại / Điểm" FontSize="12" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBox x:Name="txtClassification" Style="{StaticResource ModernDialogTextBox}"/>
                            </StackPanel>

                            <!-- Năm cấp -->
                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal" Margin="0 0 0 5">
                                    <materialDesign:PackIcon Kind="CalendarRange" Width="14" Height="14" Foreground="#475569" VerticalAlignment="Center" Margin="0 0 4 0"/>
                                    <TextBlock Text="Năm cấp / Tốt nghiệp" FontSize="12" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBox x:Name="txtGraduationYear" Style="{StaticResource ModernDialogTextBox}"/>
                            </StackPanel>

                            <!-- Checkbox Bằng chính & Ghi chú -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10 0 0 8">
                                <CheckBox x:Name="chkIsPrimary" Content="⭐ Đặt làm bằng cao nhất (bằng chính)" FontSize="13" FontWeight="SemiBold" Foreground="#D97706" Cursor="Hand"/>
                            </StackPanel>

                            <!-- Action Button -->
                            <Button x:Name="btnSaveDegree" Grid.Column="5" Click="btnSaveDegree_Click" 
                                    Height="36" Padding="20 0" VerticalAlignment="Bottom" Cursor="Hand"
                                    Background="#2563EB" BorderThickness="0" Foreground="White"
                                    materialDesign:ButtonAssist.CornerRadius="7">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Margin="0 0 6 0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtBtnSaveText" Text="Thêm bằng" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Row 4: Degrees DataGrid -->
            <Border Grid.Row="4" Margin="20,4,20,8" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
                <DataGrid x:Name="dgDegrees" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0" Background="White" MinRowHeight="44"
                          RowBackground="White" AlternatingRowBackground="#F8FAFC"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          ScrollViewer.CanContentScroll="False"
                          VirtualizingPanel.IsVirtualizing="False"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          RequestBringIntoView="dgDegrees_RequestBringIntoView"
                          VerticalScrollBarVisibility="Auto"
                          SelectionChanged="dgDegrees_SelectionChanged">
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A"/>
                    </DataGrid.Resources>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="SnapsToDevicePixels" Value="True"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F1F5F9"/>
                            <Setter Property="Foreground" Value="#334155"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="MinHeight" Value="42"/>
                            <Setter Property="Padding" Value="4,4"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="BorderBrush" Value="#CBD5E1"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" LineHeight="16"/>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <!-- STT -->
                        <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="45">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Loại bằng (Pill màu phong cách hiện đại với icon riêng cho từng danh mục) -->
                        <DataGridTemplateColumn Header="Loại bằng" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding CategoryBgBrush}" BorderBrush="{Binding CategoryBorderBrush}" 
                                            BorderThickness="1" CornerRadius="12" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="{Binding CategoryIcon}" Width="13" Height="13" Foreground="{Binding CategoryTextBrush}" Margin="0 0 5 0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DegreeType}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding CategoryTextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Tên bằng / Chứng chỉ (Căn lề trái, tự động xuống dòng khi dài, badge ⭐ Bằng chính) -->
                        <DataGridTemplateColumn Header="Tên bằng / Chứng chỉ" Width="1.5*" MinWidth="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True" VerticalAlignment="Center" Margin="10,6,8,6">
                                        <!-- Badge ⭐ Bằng chính -->
                                        <Border DockPanel.Dock="Right" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" 
                                                Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Star" Foreground="#D97706" Width="11" Height="11" Margin="0 0 3 0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Bằng chính" FontSize="10.5" FontWeight="Bold" Foreground="#92400E" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding DegreeName}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" 
                                                   VerticalAlignment="Center" HorizontalAlignment="Left" TextAlignment="Left"
                                                   TextWrapping="Wrap" ToolTip="{Binding DegreeName}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Chuyên ngành (Căn lề trái, tự động xuống dòng khi dài) -->
                        <DataGridTemplateColumn Header="Chuyên ngành" Width="130" MinWidth="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayMajor}" Foreground="{Binding MajorForeground}"
                                               FontSize="12.5" VerticalAlignment="Center" HorizontalAlignment="Left" TextAlignment="Left"
                                               TextWrapping="Wrap" Margin="10,6,8,6" ToolTip="{Binding DisplayMajor}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Cơ sở đào tạo / Nơi cấp (Căn lề trái, tự động xuống dòng khi dài) -->
                        <DataGridTemplateColumn Header="Nơi đào tạo / Cấp" Width="1.5*" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayInstitution}" Foreground="{Binding InstitutionForeground}"
                                               FontSize="12.5" VerticalAlignment="Center" HorizontalAlignment="Left" TextAlignment="Left"
                                               TextWrapping="Wrap" Margin="10,6,8,6" ToolTip="{Binding DisplayInstitution}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Xếp loại / Điểm -->
                        <DataGridTemplateColumn Header="Xếp loại / Điểm" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayClassification}" Foreground="{Binding ClassificationForeground}"
                                               FontSize="12.5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Năm cấp -->
                        <DataGridTemplateColumn Header="Năm cấp" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayGraduationYear}" Foreground="{Binding GraduationYearForeground}"
                                               FontSize="12.5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Thao tác (Bộ 3 nút icon vuông bo góc đồng bộ cực kỳ tinh tế) -->
                        <DataGridTemplateColumn Header="Thao tác" Width="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Đặt / Báo trạng thái Bằng chính -->
                                        <Button Click="btnSetPrimary_Click" Tag="{Binding}"
                                                Background="{Binding StarButtonBg}" BorderBrush="{Binding StarButtonBorder}" BorderThickness="1" 
                                                Width="28" Height="28" Padding="0" Cursor="Hand" Margin="0,0,5,0"
                                                materialDesign:ButtonAssist.CornerRadius="6"
                                                ToolTip="{Binding StarButtonTooltip}">
                                            <materialDesign:PackIcon Kind="{Binding StarButtonIcon}" Width="15" Height="15" Foreground="{Binding StarButtonFg}"/>
                                        </Button>

                                        <!-- Sửa -->
                                        <Button Click="btnEdit_Click" Tag="{Binding}"
                                                Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" 
                                                Width="28" Height="28" Padding="0" Cursor="Hand" Margin="0,0,5,0"
                                                materialDesign:ButtonAssist.CornerRadius="6"
                                                ToolTip="Sửa văn bằng này">
                                            <materialDesign:PackIcon Kind="Pencil" Width="14" Height="14" Foreground="#2563EB"/>
                                        </Button>

                                        <!-- Xóa -->
                                        <Button Click="btnDelete_Click" Tag="{Binding}"
                                                Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" 
                                                Width="28" Height="28" Padding="0" Cursor="Hand"
                                                materialDesign:ButtonAssist.CornerRadius="6"
                                                ToolTip="Xóa văn bằng này">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="14" Height="14" Foreground="#DC2626"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Row 5: Footer -->
            <Border Grid.Row="5" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CertificateOutline" Width="18" Height="18" Foreground="#64748B" VerticalAlignment="Center" Margin="0 0 8 0"/>
                        <TextBlock x:Name="txtDegreeSummary" Text="Tổng số: 0 văn bằng, chứng chỉ" FontSize="13" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button HorizontalAlignment="Right" Click="btnClose_Click"
                            Background="#334155" BorderThickness="0" Foreground="White"
                            materialDesign:ButtonAssist.CornerRadius="6" Cursor="Hand"
                            Height="34" Padding="20,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Check" Width="16" Height="16" Margin="0 0 6 0" VerticalAlignment="Center"/>
                            <TextBlock Text="Hoàn tất" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
