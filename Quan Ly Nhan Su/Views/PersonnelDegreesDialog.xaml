<Window x:Class="TaxPersonnelManagement.Views.PersonnelDegreesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Danh sách văn bằng, chứng chỉ" Height="720" Width="1100" MinWidth="1020" MinHeight="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Language="vi-VN"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Tab RadioButton Style dạng Pill/Chip đẹp mắt -->
            <Style x:Key="SegmentedTabRadioButton" TargetType="RadioButton">
                <Setter Property="Background" Value="#F1F5F9"/>
                <Setter Property="Foreground" Value="#475569"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="16 8"/>
                <Setter Property="Margin" Value="0 0 8 0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="border" Background="{TemplateBinding Background}" 
                                    CornerRadius="6" BorderThickness="1" BorderBrush="#E2E8F0" 
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#1D4ED8"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="12" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Direction="-90" RenderingBias="Quality" ShadowDepth="4" Opacity="0.25"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>  <!-- 0: Header -->
                <RowDefinition Height="Auto"/> <!-- 1: Personnel Info Banner -->
                <RowDefinition Height="Auto"/> <!-- 2: Category Filter Tabs -->
                <RowDefinition Height="Auto"/> <!-- 3: Add / Edit Form -->
                <RowDefinition Height="*"/>    <!-- 4: Degrees DataGrid -->
                <RowDefinition Height="55"/>   <!-- 5: Footer -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header -->
            <Border Grid.Row="0" Background="#1E293B" CornerRadius="12 12 0 0" Padding="20 0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CertificateOutline" Foreground="#38BDF8" Width="24" Height="24" Margin="0 0 10 0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtDialogTitle" Text="DANH SÁCH VĂN BẰNG &amp; CHỨNG CHỈ CỦA CÁN BỘ" Foreground="White" FontSize="15.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Click="btnClose_Click" Background="Transparent" BorderThickness="0" Padding="0" Width="32" Height="32" Cursor="Hand" ToolTip="Đóng">
                        <materialDesign:PackIcon Kind="Close" Foreground="#94A3B8" Width="22" Height="22"/>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Row 1: Personnel Info Banner -->
            <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Profile Chips -->
                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <!-- Cán bộ -->
                        <Border Background="White" CornerRadius="8" Padding="12 6" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0 0 10 4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="AccountTie" Width="18" Height="18" Foreground="#2563EB" VerticalAlignment="Center" Margin="0 0 6 0"/>
                                <TextBlock Text="Cán bộ: " FontWeight="Medium" Foreground="#64748B" FontSize="13"/>
                                <TextBlock x:Name="txtPersonnelName" Text="Nguyễn Văn A" FontWeight="Bold" Foreground="#0F172A" FontSize="13.5"/>
                            </StackPanel>
                        </Border>

                        <!-- Phòng ban -->
                        <Border Background="White" CornerRadius="8" Padding="12 6" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0 0 10 4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="OfficeBuilding" Width="18" Height="18" Foreground="#0284C7" VerticalAlignment="Center" Margin="0 0 6 0"/>
                                <TextBlock Text="Phòng ban: " FontWeight="Medium" Foreground="#64748B" FontSize="13"/>
                                <TextBlock x:Name="txtPersonnelDept" Text="---" FontWeight="SemiBold" Foreground="#1E293B" FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <!-- Chức vụ -->
                        <Border Background="White" CornerRadius="8" Padding="12 6" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0 0 10 4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="BriefcaseOutline" Width="18" Height="18" Foreground="#0D9488" VerticalAlignment="Center" Margin="0 0 6 0"/>
                                <TextBlock Text="Chức vụ: " FontWeight="Medium" Foreground="#64748B" FontSize="13"/>
                                <TextBlock x:Name="txtPersonnelPosition" Text="---" FontWeight="SemiBold" Foreground="#1E293B" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- Hint note -->
                    <Border Grid.Column="1" Background="#FEF3C7" CornerRadius="8" Padding="12 6" BorderBrush="#FDE68A" BorderThickness="1" VerticalAlignment="Center" Margin="0 0 0 4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="StarCheck" Width="16" Height="16" Foreground="#D97706" VerticalAlignment="Center" Margin="0 0 6 0"/>
                            <TextBlock Text="Bằng có dấu ⭐ sẽ được hiển thị ra ngoài hồ sơ cán bộ" FontSize="12" Foreground="#92400E" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Row 2: Category Filter Tabs -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,10">
                <WrapPanel VerticalAlignment="Center">
                    <RadioButton x:Name="rbTabAll" Content="📑 Tất cả văn bằng" GroupName="DegreeTypeTabs" 
                                 Style="{StaticResource SegmentedTabRadioButton}" 
                                 Checked="TabFilter_Checked" IsChecked="True"/>
                    <RadioButton x:Name="rbTabIT" Content="💻 Tin học" GroupName="DegreeTypeTabs" 
                                 Style="{StaticResource SegmentedTabRadioButton}" 
                                 Checked="TabFilter_Checked"/>
                    <RadioButton x:Name="rbTabLang" Content="🌐 Ngoại ngữ" GroupName="DegreeTypeTabs" 
                                 Style="{StaticResource SegmentedTabRadioButton}" 
                                 Checked="TabFilter_Checked"/>
                    <RadioButton x:Name="rbTabMajor" Content="🎓 Trình độ chuyên môn" GroupName="DegreeTypeTabs" 
                                 Style="{StaticResource SegmentedTabRadioButton}" 
                                 Checked="TabFilter_Checked"/>
                    <RadioButton x:Name="rbTabState" Content="🏛️ QL Nhà nước &amp; LLCT" GroupName="DegreeTypeTabs" 
                                 Style="{StaticResource SegmentedTabRadioButton}" 
                                 Checked="TabFilter_Checked"/>
                </WrapPanel>
            </Border>

            <!-- Row 3: Add / Edit Form -->
            <Border Grid.Row="3" Margin="20,12,20,8" Padding="18,14" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Direction="-90" ShadowDepth="2" Opacity="0.06"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Form Header -->
                    <Grid Grid.Row="0" Margin="0 0 0 12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon x:Name="iconFormMode" Kind="PlusCircleOutline" Width="19" Height="19" Foreground="#2563EB" VerticalAlignment="Center" Margin="0 0 6 0"/>
                            <TextBlock x:Name="txtFormModeTitle" Text="Thêm văn bằng, chứng chỉ mới" FontWeight="Bold" FontSize="13.5" Foreground="#2563EB" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="btnCancelEdit" Click="btnCancelEdit_Click" 
                                Background="#FEE2E2" BorderThickness="1" BorderBrush="#FECACA" Cursor="Hand"
                                Height="28" Padding="10 0" HorizontalAlignment="Right" Foreground="#DC2626" Visibility="Collapsed"
                                materialDesign:ButtonAssist.CornerRadius="6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Margin="0 0 4 0" VerticalAlignment="Center"/>
                                <TextBlock Text="Hủy sửa" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Form Fields -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Line 1: Loại bằng, Tên bằng, Chuyên ngành, Nơi cấp -->
                        <Grid Grid.Row="0" Margin="0 0 0 10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Loại bằng -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Loại bằng *" FontSize="12" Foreground="#475569" FontWeight="SemiBold" Margin="0 0 0 4"/>
                                <ComboBox x:Name="cboDegreeType" SelectionChanged="cboDegreeType_SelectionChanged" Height="34" Padding="8,4" FontSize="13" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1">
                                    <ComboBoxItem Content="Tin học" IsSelected="True"/>
                                    <ComboBoxItem Content="Ngoại ngữ"/>
                                    <ComboBoxItem Content="Chuyên môn"/>
                                    <ComboBoxItem Content="Quản lý Nhà nước"/>
                                    <ComboBoxItem Content="Lý luận chính trị"/>
                                    <ComboBoxItem Content="Chứng chỉ khác"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Tên bằng / chứng chỉ -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tên bằng / Chứng chỉ *" FontSize="12" Foreground="#475569" FontWeight="SemiBold" Margin="0 0 0 4"/>
                                <ComboBox x:Name="cboDegreeName" IsEditable="True" Height="34" Padding="8,4" FontSize="13" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"/>
                            </StackPanel>

                            <!-- Chuyên ngành -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Chuyên ngành / Lĩnh vực" FontSize="12" Foreground="#475569" FontWeight="SemiBold" Margin="0 0 0 4"/>
                                <TextBox x:Name="txtDegreeMajor" Height="34" Padding="8,4" FontSize="13" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"/>
                            </StackPanel>

                            <!-- Cơ sở đào tạo / Nơi cấp -->
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Cơ sở đào tạo / Nơi cấp" FontSize="12" Foreground="#475569" FontWeight="SemiBold" Margin="0 0 0 4"/>
                                <TextBox x:Name="txtInstitution" Height="34" Padding="8,4" FontSize="13" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"/>
                            </StackPanel>
                        </Grid>

                        <!-- Line 2: Xếp loại, Năm/Ngày cấp, Checkbox Bằng chính, Nút Lưu -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Xếp loại / Điểm số -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Xếp loại / Điểm" FontSize="12" Foreground="#475569" FontWeight="SemiBold" Margin="0 0 0 4"/>
                                <TextBox x:Name="txtClassification" Height="34" Padding="8,4" FontSize="13" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"/>
                            </StackPanel>

                            <!-- Năm cấp -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Năm cấp / Tốt nghiệp" FontSize="12" Foreground="#475569" FontWeight="SemiBold" Margin="0 0 0 4"/>
                                <TextBox x:Name="txtGraduationYear" Height="34" Padding="8,4" FontSize="13" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"/>
                            </StackPanel>

                            <!-- Checkbox Bằng chính & Ghi chú -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="10 16 0 0">
                                <CheckBox x:Name="chkIsPrimary" Content="⭐ Đặt làm bằng cao nhất (bằng chính)" FontSize="13" FontWeight="SemiBold" Foreground="#D97706" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Action Button -->
                            <Button x:Name="btnSaveDegree" Grid.Column="5" Click="btnSaveDegree_Click" 
                                    Height="34" Padding="18 0" Margin="0 16 0 0" Cursor="Hand"
                                    Background="#2563EB" BorderThickness="0" Foreground="White"
                                    materialDesign:ButtonAssist.CornerRadius="6">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Margin="0 0 6 0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtBtnSaveText" Text="Thêm bằng" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Row 4: Degrees DataGrid -->
            <Border Grid.Row="4" Margin="20,4,20,8" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
                <DataGrid x:Name="dgDegrees" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9" Background="White" RowHeight="42"
                          ScrollViewer.CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#334155"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="12.5"/>
                            <Setter Property="Height" Value="40"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <!-- STT -->
                        <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="45">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Loại bằng -->
                        <DataGridTemplateColumn Header="Loại bằng" Width="135">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DegreeType}" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Tên bằng / Chứng chỉ (Độ rộng 250, dùng WrapPanel và badge Bằng chính không bị cắt) -->
                        <DataGridTemplateColumn Header="Tên bằng / Chứng chỉ" Width="250">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <WrapPanel VerticalAlignment="Center" Margin="10,4">
                                        <TextBlock Text="{Binding DegreeName}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        <!-- Badge ⭐ Bằng chính -->
                                        <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Star" Foreground="#D97706" Width="12" Height="12" Margin="0 0 3 0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Bằng chính" FontSize="11" FontWeight="Bold" Foreground="#92400E" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Chuyên ngành -->
                        <DataGridTextColumn Header="Chuyên ngành" Binding="{Binding Major}" Width="145">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="FontSize" Value="12.5"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Cơ sở đào tạo / Nơi cấp -->
                        <DataGridTextColumn Header="Nơi đào tạo / Cấp" Binding="{Binding Institution}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="FontSize" Value="12.5"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Xếp loại / Điểm (Rộng 125 đảm bảo tiêu đề không bị cắt) -->
                        <DataGridTextColumn Header="Xếp loại / Điểm" Binding="{Binding Classification}" Width="125">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="12.5"/>
                                    <Setter Property="Foreground" Value="#334155"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Năm cấp -->
                        <DataGridTextColumn Header="Năm cấp" Binding="{Binding GraduationYear}" Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="12.5"/>
                                    <Setter Property="Foreground" Value="#334155"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Thao tác -->
                        <DataGridTemplateColumn Header="Thao tác" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Đặt làm bằng chính -->
                                        <Button Click="btnSetPrimary_Click" Tag="{Binding}"
                                                Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" Cursor="Hand"
                                                Height="26" Padding="6,0" Margin="0,0,5,0"
                                                materialDesign:ButtonAssist.CornerRadius="4"
                                                ToolTip="Đặt làm bằng hiển thị chính trên form">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="StarOutline" Width="14" Height="14" Foreground="#D97706" VerticalAlignment="Center"/>
                                                <TextBlock Text="Bằng chính" FontSize="11" Foreground="#92400E" FontWeight="SemiBold" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Sửa -->
                                        <Button Click="btnEdit_Click" Tag="{Binding}"
                                                Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Padding="0" Cursor="Hand"
                                                Width="26" Height="26" Margin="0,0,3,0"
                                                materialDesign:ButtonAssist.CornerRadius="4"
                                                ToolTip="Sửa văn bằng này">
                                            <materialDesign:PackIcon Kind="Pencil" Width="14" Height="14" Foreground="#2563EB"/>
                                        </Button>

                                        <!-- Xóa -->
                                        <Button Click="btnDelete_Click" Tag="{Binding}"
                                                Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" Padding="0" Cursor="Hand"
                                                Width="26" Height="26"
                                                materialDesign:ButtonAssist.CornerRadius="4"
                                                ToolTip="Xóa văn bằng này">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="14" Height="14" Foreground="#DC2626"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Row 5: Footer -->
            <Border Grid.Row="5" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CertificateOutline" Width="18" Height="18" Foreground="#64748B" VerticalAlignment="Center" Margin="0 0 8 0"/>
                        <TextBlock x:Name="txtDegreeSummary" Text="Tổng số: 0 văn bằng, chứng chỉ" FontSize="13" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button HorizontalAlignment="Right" Click="btnClose_Click"
                            Background="#334155" BorderThickness="0" Foreground="White"
                            materialDesign:ButtonAssist.CornerRadius="6" Cursor="Hand"
                            Height="34" Padding="20,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Check" Width="16" Height="16" Margin="0 0 6 0" VerticalAlignment="Center"/>
                            <TextBlock Text="Hoàn tất" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
