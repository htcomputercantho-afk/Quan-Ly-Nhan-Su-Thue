<Window x:Class="TaxPersonnelManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Language="vi-VN"
        Title="Quản Lý Nhân Sự" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Icon="icon.ico"
        WindowState="Maximized"
        FontFamily="{DynamicResource MaterialDesignFont}"
        FontSize="15"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SizeChanged="MainWindow_SizeChanged"
        StateChanged="MainWindow_StateChanged"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource PrimaryColor}">

    <!-- Configure WindowChrome for Custom Title Bar (Microsoft Word style) -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Style for Title Bar Control Buttons (Minimize, Maximize, Close) -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2EFFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#4DFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style for Close Button (Red on Hover) -->
        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C42B1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid x:Name="RootWindowGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/> <!-- Custom Title Bar Row -->
            <RowDefinition Height="*"/>  <!-- Main Application Body -->
        </Grid.RowDefinitions>

        <!-- ============================================== -->
        <!--   CUSTOM TITLE BAR (Microsoft Word Style)      -->
        <!-- ============================================== -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryColor}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- App Icon & Brand Title -->
                    <ColumnDefinition Width="*"/>    <!-- Draggable Caption Area -->
                    <ColumnDefinition Width="Auto"/> <!-- User Welcome Badge & Caption Controls -->
                </Grid.ColumnDefinitions>

                <!-- Left: Logo & Window Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12 0 0 0">
                    <Image Source="/logo.png" Width="20" Height="20" VerticalAlignment="Center" Margin="0 0 10 0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="QUẢN LÝ NHÂN SỰ" FontFamily="{StaticResource AppHeadingFont}" FontWeight="Bold" FontSize="13.5" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: Draggable area (empty space inherits window drag and double-click to maximize) -->

                <!-- Right: User Welcome Info + Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <!-- User Welcome Badge (HitTestVisible so it can be hovered / clicked) -->
                    <Border Background="#1AFFFFFF" CornerRadius="13" Padding="10 3" Margin="0 0 12 0" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AccountCircle" Width="18" Height="18" Foreground="White" Margin="0 0 6 0" VerticalAlignment="Center"/>
                            <TextBlock Text="Xin chào, " VerticalAlignment="Center" Foreground="#E0E8F5" FontSize="12.5"/>
                            <TextBlock x:Name="txtWelcome" Text="User" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" FontSize="12.5"/>
                        </StackPanel>
                    </Border>

                    <!-- Divider -->
                    <Rectangle Width="1" Height="16" Fill="#40FFFFFF" VerticalAlignment="Center" Margin="0 0 4 0"/>

                    <!-- Minimize, Maximize/Restore, Close Buttons -->
                    <StackPanel Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Minimize Button -->
                        <Button x:Name="btnMinimize" Style="{StaticResource TitleBarButtonStyle}" Click="btnMinimize_Click" ToolTip="Thu nhỏ">
                            <Path Data="M 0,5 L 10,5" Stroke="White" StrokeThickness="1.2" SnapsToDevicePixels="True" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>

                        <!-- Maximize / Restore Button -->
                        <Button x:Name="btnMaximize" Style="{StaticResource TitleBarButtonStyle}" Click="btnMaximize_Click" ToolTip="Phóng to">
                            <Path x:Name="pathMaximize" Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z" Stroke="White" StrokeThickness="1.2" SnapsToDevicePixels="True" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>

                        <!-- Close Button -->
                        <Button x:Name="btnClose" Style="{StaticResource TitleBarCloseButtonStyle}" Click="btnClose_Click" ToolTip="Đóng">
                            <Path Data="M 0,0 L 10,10 M 0,10 L 10,0" Stroke="White" StrokeThickness="1.2" SnapsToDevicePixels="True" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!--   MAIN APPLICATION BODY (Row 1)                -->
        <!-- ============================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="colSidebar" Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

        <!-- Sidebar (Deep Blue Brand Color) -->
        <Border Grid.Column="0" Background="{DynamicResource PrimaryColor}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel.Resources>
                             <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Height" Value="50"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="Padding" Value="25 0"/>
                                <Setter Property="Margin" Value="10 5"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="10"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#33FFFFFF"/> <!-- Semi-transparent white hover -->
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Resources>
                        
                        <Button x:Name="btnLogoToggle" Click="btnToggleSidebar_Click" 
                                Background="Transparent" BorderThickness="0" Height="70" Margin="0 10" 
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0"
                                Cursor="Hand" ToolTip="Thu gọn/Phóng to menu"
                                Style="{StaticResource {x:Type Button}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Image x:Name="imgLogo" Source="/logo.png" Width="48" Height="48" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Margin="0 0 10 0"/>
                                <TextBlock x:Name="txtLogo" Text="QUẢN LÝ NHÂN SỰ" FontFamily="{StaticResource AppHeadingFont}" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
        
                        <Separator Background="White" Opacity="0.3" Margin="20 10 20 20"/>
        
                        <!-- Navigation Buttons (White on Blue) -->
                        <Button x:Name="btnDashboard" Click="NavigateDashboard" ToolTip="Tổng quan">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon x:Name="iconDashboard" Kind="ViewDashboard" Width="22" Height="22" Margin="0 0 15 0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtOverview" Text="Tổng quan" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnStatistics" Click="NavigateStatistics" ToolTip="Thống kê">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon x:Name="iconStatistics" Kind="ChartPie" Width="22" Height="22" Margin="0 0 15 0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtStatistics" Text="Thống kê" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
        
                        <Button x:Name="btnPersonnel" Click="NavigatePersonnel" ToolTip="Nhân sự">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon x:Name="iconPersonnel" Kind="AccountGroup" Width="22" Height="22" Margin="0 0 15 0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtPersonnel" Text="Nhân sự" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
        
                        <Button x:Name="btnSalary" Click="NavigateSalary" ToolTip="Nâng lương">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon x:Name="iconSalary" Kind="CashMultiple" Width="22" Height="22" Margin="0 0 15 0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtSalary" Text="Nâng lương" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
        
                        <Button x:Name="btnAnnualIncome" Click="NavigateAnnualIncome" ToolTip="Tổng thu nhập năm">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon x:Name="iconAnnualIncome" Kind="ChartLine" Width="22" Height="22" Margin="0 0 15 0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtAnnualIncome" Text="Tổng thu nhập năm" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
        
                        <Button x:Name="btnLeaveDetail" Click="NavigateLeaveDetail" ToolTip="Chi tiết nghỉ">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CalendarClock" Width="22" Height="22" VerticalAlignment="Center" Margin="0 0 15 0"/>
                                <TextBlock x:Name="txtLeaveDetail" Text="Chi tiết Nghỉ" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnPositionDuration" Click="NavigatePositionDuration" ToolTip="Thời gian giữ vị trí công tác">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Timer" Width="22" Height="22" Margin="0 0 15 0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtPositionDuration" Text="Thời gian công tác" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
        
                        <Button x:Name="btnEmulationReward" Click="NavigateEmulationReward" ToolTip="Thi đua khen thưởng">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon x:Name="iconEmulationReward" Kind="Medal" Width="22" Height="22" Margin="0 0 15 0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtEmulationReward" Text="Thi đua khen thưởng" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
        
                        <Button x:Name="btnEvaluation" Click="NavigateEvaluation" ToolTip="Xếp loại">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon x:Name="iconEvaluation" Kind="Certificate" Width="22" Height="22" Margin="0 0 15 0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtEvaluation" Text="Đánh giá xếp loại chất lượng công chức" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="145"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnTraining" Click="NavigateTraining" ToolTip="Đào tạo và Bồi dưỡng">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="School" Width="22" Height="22" Margin="0 0 15 0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtTraining" Text="Đào tạo, Bồi dưỡng" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnPlanning" Click="NavigatePlanning" ToolTip="Quy hoạch">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="AccountStar" Width="22" Height="22" Margin="0 0 15 0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtPlanning" Text="Quy hoạch" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnRotation" Click="NavigateRotation" ToolTip="Luân chuyển, Điều động">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="SwapHorizontal" Width="22" Height="22" Margin="0 0 15 0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtRotation" Text="Luân chuyển, Điều động" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="150"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnDutyAssignment" Click="NavigateDutyAssignment" ToolTip="Phân công nhiệm vụ">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ClipboardTextClockOutline" Width="22" Height="22" Margin="0 0 15 0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtDutyAssignment" Text="Phân công nhiệm vụ" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="150"/>
                            </StackPanel>
                        </Button>

                        <Separator Background="White" Margin="20" Opacity="0.3"/>
                        
                        <Button x:Name="btnUsers" Click="NavigateUsers" ToolTip="Tài khoản">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon x:Name="iconUsers" Kind="AccountKey" Width="22" Height="22" Margin="0 0 15 0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtUsers" Text="Tài khoản" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
        
                        <Button x:Name="btnBackupRestore" Click="NavigateBackupRestore" ToolTip="Sao lưu &amp; Phục hồi">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon x:Name="iconBackupRestore" Kind="DatabaseCog" Width="22" Height="22" Margin="0 0 15 0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtBackupRestore" Text="Sao lưu &amp; Phục hồi" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <Button x:Name="btnLogout" Click="Logout_Click" Margin="10 20" ToolTip="Đăng xuất">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon x:Name="iconLogout" Kind="Logout" Width="22" Height="22" Margin="0 0 15 0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtLogout" Text="Đăng xuất" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock x:Name="txtCopyright" Text="Copyright © 2026 Linhoang" Foreground="White" Opacity="0.6" FontSize="13" FontFamily="{StaticResource AppRegularFont}" FontWeight="Medium" HorizontalAlignment="Center" Margin="0 5 0 0"/>
                    <TextBlock x:Name="txtVersion" Text="Version 1.0.0.0" Foreground="White" Opacity="0.4" FontSize="11" HorizontalAlignment="Center" Margin="0 2 0 15"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area (Maximizes vertical data display) -->
        <Grid Grid.Column="1" Background="#F5F5F5">
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Margin="12 10"/>
        </Grid>
        </Grid>
    </Grid>
</Window>
